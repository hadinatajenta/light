---
import Pagination from '@/components/Pagination.astro';
import PostList from '@/components/PostList.astro';
import { POSTS_PER_PAGE } from '@/consts';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedPostSummaries } from '@/lib/content/public';
import { paginateItems } from '@/utils/pagination';

export const prerender = false;

const requestedPage = Number.parseInt(Astro.params.page ?? '1', 10) || 1;
const posts = await getPublishedPostSummaries();
const { pageItems, totalPages, currentPage } = paginateItems(posts, requestedPage, POSTS_PER_PAGE);
---

<BaseLayout
  title={`Guides - Page ${currentPage}`}
  description={`Page ${currentPage} of every buying guide and product review on the site.`}
  noindex={true}
>
  <h1 class="text-3xl font-semibold tracking-tight">Guides</h1>
  <div class="mt-8">
    <PostList posts={pageItems} />
  </div>
  <Pagination currentPage={currentPage} totalPages={totalPages} />
</BaseLayout>
