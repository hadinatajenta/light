---
import Pagination from '@/components/Pagination.astro';
import PostList from '@/components/PostList.astro';
import { POSTS_PER_PAGE } from '@/consts';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedPostSummaries } from '@/lib/content/public';
import { paginateItems } from '@/utils/pagination';

export const prerender = false;

const posts = await getPublishedPostSummaries();
const { pageItems, totalPages, currentPage } = paginateItems(posts, 1, POSTS_PER_PAGE);
---

<BaseLayout title="All Buying Guides" description="Every desk gear and work device buying guide on Light Scripts, newest first.">
  <h1 class="text-3xl font-semibold tracking-tight">Guides</h1>
  <div class="mt-8">
    <PostList posts={pageItems} />
  </div>
  <Pagination currentPage={currentPage} totalPages={totalPages} />
</BaseLayout>
