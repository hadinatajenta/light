---
import { ChartPanel } from '@/components/dashboard/chart-panel';
import ViewsPanel from '@/components/dashboard/views-panel';
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { buildCadenceDatasets } from '@/lib/analytics/cadence';
import { loadAnalyticsSnapshot, loadTopicHighlights } from '@/lib/analytics/store';
import { loadViewSnapshot } from '@/lib/analytics/views';
import { requireContentDatabase } from '@/lib/content/database';
import { formatRelativeTime } from '@/utils/date';

export const prerender = false;

const database = await requireContentDatabase();
const [snapshot, topics, views] = await Promise.all([
  loadAnalyticsSnapshot(database),
  loadTopicHighlights(database),
  loadViewSnapshot(database, { days: 30 }),
]);

const { content, pipeline, agents, affiliate, activity, media } = snapshot;

const cadenceDatasets = buildCadenceDatasets(content.series);

const publishedDelta = content.publishedLast30 - content.publishedPrevious30;
const categoryMax = Math.max(1, ...content.byCategory.map((entry) => entry.count));
const tagMax = Math.max(1, ...content.byTag.map((entry) => entry.count));
const clickMax = Math.max(1, ...affiliate.clicksByDay);

const coverShare =
  content.published > 0 ? Math.round((content.withCover / content.published) * 100) : 0;
const affiliateShare =
  content.published > 0 ? Math.round((content.withAffiliateLinks / content.published) * 100) : 0;

const agentRunMax = Math.max(1, ...agents.perAgent.map((agent) => agent.runs));

const funnelStages = [
  { label: 'Queued', value: pipeline.topicsQueued },
  { label: 'Fetched', value: pipeline.topicsFetched },
  { label: 'Researched', value: pipeline.topicsResearched },
  { label: 'In progress', value: pipeline.topicsInProgress },
  { label: 'Used', value: pipeline.topicsUsed },
  { label: 'Blocked', value: pipeline.topicsBlocked },
  { label: 'Dead', value: pipeline.topicsDead },
];
const funnelTotal = Math.max(
  1,
  funnelStages.reduce((sum, stage) => sum + stage.value, 0),
);

const mediaSize =
  media.totalBytes >= 1024 * 1024
    ? `${(media.totalBytes / (1024 * 1024)).toFixed(1)} MB`
    : `${Math.round(media.totalBytes / 1024)} KB`;
---

<DashboardLayout title="Insights">
  <div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <div>
        <h2 class="text-lg font-semibold tracking-tight">Insights</h2>
        <p class="mt-0.5 text-xs text-muted-foreground">
          Generated {formatRelativeTime(snapshot.generatedAt)}. Cost figures are estimates derived
          from token counts at published DeepSeek rates, not billed amounts.
        </p>
      </div>
      <a
        href="/dashboard"
        class="whitespace-nowrap text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
      >
        Back to overview
      </a>
    </div>

    <ViewsPanel client:load initial={views} />

    <section aria-label="Content performance" class="flex flex-col gap-4">
      <h3 class="text-sm font-medium">Content performance</h3>

      <div class="grid gap-4 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <ChartPanel client:visible datasets={cadenceDatasets} defaultDatasetId="30d" />
        </div>

        <div class="rounded-xl border border-border bg-card p-6">
          <h4 class="text-sm font-medium">Quality signals</h4>
          <dl class="mt-4 flex flex-col gap-4 text-sm">
            <div>
              <div class="flex items-baseline justify-between gap-3">
                <dt class="text-muted-foreground">Average length</dt>
                <dd class="tabular-nums">{content.averageWords} words</dd>
              </div>
              <p class="mt-1 text-xs text-muted-foreground">
                Guides below roughly 900 words rarely answer a buying question fully.
              </p>
            </div>
            <div>
              <div class="flex items-baseline justify-between gap-3">
                <dt class="text-muted-foreground">Cover image</dt>
                <dd class="tabular-nums">{coverShare}%</dd>
              </div>
              <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-primary" style={`width: ${coverShare}%`} />
              </div>
            </div>
            <div>
              <div class="flex items-baseline justify-between gap-3">
                <dt class="text-muted-foreground">Affiliate links</dt>
                <dd class="tabular-nums">{affiliateShare}%</dd>
              </div>
              <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-primary" style={`width: ${affiliateShare}%`} />
              </div>
              <p class="mt-1 text-xs text-muted-foreground">
                An article without a product link cannot earn anything.
              </p>
            </div>
          </dl>
          <p class="mt-4 border-t border-border pt-4 text-xs text-muted-foreground tabular-nums">
            {publishedDelta === 0
              ? 'Publishing is flat versus the previous 30 days.'
              : `${publishedDelta > 0 ? '+' : ''}${publishedDelta} articles versus the previous 30 days.`}
          </p>
        </div>
      </div>

      <div class="grid gap-4 lg:grid-cols-3">
        <div class="rounded-xl border border-border bg-card p-6">
          <h4 class="text-sm font-medium">By category</h4>
          <ul class="mt-4 flex flex-col gap-3">
            {
              content.byCategory.length === 0 ? (
                <li class="text-sm text-muted-foreground">No published articles yet.</li>
              ) : (
                content.byCategory.map((entry) => (
                  <li>
                    <div class="flex items-baseline justify-between gap-3 text-sm">
                      <span class="truncate">{entry.category}</span>
                      <span class="tabular-nums text-muted-foreground">{entry.count}</span>
                    </div>
                    <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                      <div
                        class="h-full rounded-full bg-primary"
                        style={`width: ${Math.round((entry.count / categoryMax) * 100)}%`}
                      />
                    </div>
                  </li>
                ))
              )
            }
          </ul>
        </div>

        <div class="rounded-xl border border-border bg-card p-6">
          <h4 class="text-sm font-medium">Top tags</h4>
          <ul class="mt-4 flex flex-col gap-2">
            {
              content.byTag.length === 0 ? (
                <li class="text-sm text-muted-foreground">No tags in use yet.</li>
              ) : (
                content.byTag.map((entry) => (
                  <li class="flex items-center gap-3 text-sm">
                    <span class="w-28 shrink-0 truncate">{entry.tag}</span>
                    <span class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                      <span
                        class="block h-full rounded-full bg-primary/70"
                        style={`width: ${Math.round((entry.count / tagMax) * 100)}%`}
                      />
                    </span>
                    <span class="tabular-nums text-muted-foreground">{entry.count}</span>
                  </li>
                ))
              )
            }
          </ul>
        </div>

        <div class="rounded-xl border border-border bg-card p-6">
          <h4 class="text-sm font-medium">Stalled drafts</h4>
          {
            content.longestDrafts.length === 0 ? (
              <p class="mt-4 text-sm text-muted-foreground">No drafts waiting.</p>
            ) : (
              <ul class="mt-4 flex flex-col divide-y divide-border text-sm">
                {content.longestDrafts.map((draft) => (
                  <li class="flex items-baseline justify-between gap-3 py-2">
                    <a
                      href={`/dashboard/posts/${draft.id}/edit`}
                      class="min-w-0 truncate underline-offset-4 hover:underline"
                    >
                      {draft.title}
                    </a>
                    <span class="shrink-0 tabular-nums text-muted-foreground">
                      {draft.days}d idle
                    </span>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </div>
    </section>

    <section aria-label="Agent operations" class="flex flex-col gap-4">
      <h3 class="text-sm font-medium">Agent operations</h3>

      <dl class="grid grid-cols-2 gap-4 sm:grid-cols-5">
        {
          [
            { label: 'Runs 24h', value: agents.runsLast24h },
            { label: 'Runs 7d', value: agents.runsLast7d },
            { label: 'Success rate', value: `${agents.successRate}%` },
            { label: 'Tokens out', value: agents.tokensOut },
            { label: 'Est. cost', value: `$${agents.estimatedCostUsd}` },
          ].map((metric) => (
            <div class="rounded-xl border border-border bg-card p-4">
              <dt class="text-xs tracking-wider text-muted-foreground uppercase">{metric.label}</dt>
              <dd class="mt-1 text-2xl font-semibold tabular-nums">{metric.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="rounded-xl border border-border bg-card p-6">
        <h4 class="text-sm font-medium">Per agent</h4>
        {
          agents.perAgent.length === 0 ? (
            <p class="mt-4 text-sm text-muted-foreground">No agents configured yet.</p>
          ) : (
            <div class="mt-4 overflow-x-auto">
              <table class="w-full min-w-[46rem] text-sm">
                <thead>
                  <tr class="border-b border-border text-left text-xs tracking-wider text-muted-foreground uppercase">
                    <th scope="col" class="py-2 pr-3 font-medium">Agent</th>
                    <th scope="col" class="py-2 pr-3 font-medium">Role</th>
                    <th scope="col" class="py-2 pr-3 font-medium">Share</th>
                    <th scope="col" class="py-2 pr-3 text-right font-medium">Runs</th>
                    <th scope="col" class="py-2 pr-3 text-right font-medium">Failed</th>
                    <th scope="col" class="py-2 pr-3 text-right font-medium">Tokens in</th>
                    <th scope="col" class="py-2 pr-3 text-right font-medium">Tokens out</th>
                    <th scope="col" class="py-2 font-medium">Next run</th>
                  </tr>
                </thead>
                <tbody>
                  {agents.perAgent.map((agent) => (
                    <tr class="border-b border-border/60 last:border-0">
                      <th scope="row" class="py-2 pr-3 text-left font-medium">{agent.name}</th>
                      <td class="py-2 pr-3 text-muted-foreground">{agent.role}</td>
                      <td class="py-2 pr-3">
                        <span class="block h-1.5 w-24 overflow-hidden rounded-full bg-muted">
                          <span
                            class="block h-full rounded-full bg-primary"
                            style={`width: ${Math.round((agent.runs / agentRunMax) * 100)}%`}
                          />
                        </span>
                      </td>
                      <td class="py-2 pr-3 text-right tabular-nums">{agent.runs}</td>
                      <td class="py-2 pr-3 text-right tabular-nums">{agent.failedRuns}</td>
                      <td class="py-2 pr-3 text-right tabular-nums">{agent.tokensIn}</td>
                      <td class="py-2 pr-3 text-right tabular-nums">{agent.tokensOut}</td>
                      <td class="py-2 text-muted-foreground tabular-nums">
                        {formatRelativeTime(agent.nextRunAt ?? '')}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }
      </div>

      <div class="rounded-xl border border-border bg-card p-6">
        <h4 class="text-sm font-medium">Recent runs</h4>
        {
          agents.recentRuns.length === 0 ? (
            <p class="mt-4 text-sm text-muted-foreground">No runs recorded yet.</p>
          ) : (
            <ul class="mt-4 flex flex-col divide-y divide-border">
              {agents.recentRuns.map((run) => (
                <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 py-2 text-sm">
                  <span class="font-medium">{run.agentName}</span>
                  <span
                    class:list={[
                      'text-xs',
                      run.status === 'failed' ? 'text-destructive' : 'text-muted-foreground',
                    ]}
                  >
                    {run.status}
                  </span>
                  <span class="min-w-0 flex-1 truncate text-muted-foreground">
                    {run.summary ?? 'No summary'}
                  </span>
                  <span class="text-xs text-muted-foreground tabular-nums">
                    {run.tokensOut ?? 0} out
                  </span>
                  <span class="text-xs text-muted-foreground tabular-nums">
                    {formatRelativeTime(run.startedAt)}
                  </span>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </section>

    <section aria-label="Affiliate readiness" class="flex flex-col gap-4">
      <h3 class="text-sm font-medium">Affiliate readiness</h3>

      <div class="grid gap-4 lg:grid-cols-3">
        <div class="rounded-xl border border-border bg-card p-6 lg:col-span-2">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h4 class="text-sm font-medium">Clicks over 30 days</h4>
            <span class="text-xs text-muted-foreground tabular-nums">
              {affiliate.clicks.last30d} total in window
            </span>
          </div>

          <div class="mt-5 flex h-24 items-end gap-1" role="img" aria-label="Affiliate clicks per day over the last 30 days">
            {
              affiliate.clicksByDay.map((value, index) => (
                <span
                  class="flex-1 rounded-t bg-primary/70"
                  style={`height: ${Math.max(2, Math.round((value / clickMax) * 100))}%`}
                  title={`Day ${index + 1}: ${value} clicks`}
                />
              ))
            }
          </div>

          <dl class="mt-5 grid grid-cols-2 gap-4 border-t border-border pt-4 sm:grid-cols-4">
            {
              [
                { label: '24h', value: affiliate.clicks.last24h },
                { label: '7d', value: affiliate.clicks.last7d },
                { label: '30d', value: affiliate.clicks.last30d },
                { label: 'All time', value: affiliate.clicks.total },
              ].map((window) => (
                <div>
                  <dt class="text-xs tracking-wider text-muted-foreground uppercase">
                    {window.label}
                  </dt>
                  <dd class="mt-1 text-2xl font-semibold tabular-nums">{window.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="rounded-xl border border-border bg-card p-6">
          <h4 class="text-sm font-medium">Top products</h4>
          {
            affiliate.topProducts.length === 0 ? (
              <p class="mt-4 text-sm text-muted-foreground">
                No clicks yet. They appear once articles carry product links and readers follow them.
              </p>
            ) : (
              <ol class="mt-4 flex flex-col divide-y divide-border text-sm">
                {affiliate.topProducts.map((product) => (
                  <li class="flex items-baseline justify-between gap-3 py-2">
                    <span class="min-w-0 truncate">{product.name}</span>
                    <span class="shrink-0 tabular-nums text-muted-foreground">
                      {product.clicks} clicks
                    </span>
                  </li>
                ))}
              </ol>
            )
          }
          <dl class="mt-4 grid gap-2 border-t border-border pt-4 text-sm">
            <div class="flex items-baseline justify-between gap-3">
              <dt class="text-muted-foreground">Programs</dt>
              <dd class="tabular-nums">{affiliate.programs}</dd>
            </div>
            <div class="flex items-baseline justify-between gap-3">
              <dt class="text-muted-foreground">Products</dt>
              <dd class="tabular-nums">
                {affiliate.activeProducts} of {affiliate.products} active
              </dd>
            </div>
          </dl>
        </div>
      </div>

      {
        affiliate.brokenReferences.length > 0 && (
          <div class="rounded-xl border border-destructive/40 bg-destructive/5 p-6">
            <h4 class="text-sm font-medium">Broken product references</h4>
            <p class="mt-1 text-sm text-muted-foreground">
              These articles reference a product slug that no longer exists, so the link is dropped
              from the page.
            </p>
            <ul class="mt-3 flex flex-col gap-2 text-sm">
              {affiliate.brokenReferences.map((reference) => (
                <li class="flex flex-wrap items-baseline gap-x-3">
                  <span class="font-medium">{reference.postTitle}</span>
                  <span class="font-mono text-xs text-muted-foreground">{reference.slug}</span>
                  <a
                    href="/dashboard/monetization/catalog"
                    class="text-xs underline-offset-4 hover:underline"
                  >
                    Fix in catalog
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </section>

    <section aria-label="Automation health" class="flex flex-col gap-4">
      <h3 class="text-sm font-medium">Automation health</h3>

      <div class="rounded-xl border border-border bg-card p-6">
        <h4 class="text-sm font-medium">Topic funnel</h4>
        <div class="mt-4 flex h-3 w-full overflow-hidden rounded-full bg-muted">
          {
            funnelStages.map((stage) => (
              <div
                class:list={[
                  'h-full',
                  stage.label === 'Blocked'
                    ? 'bg-destructive/60'
                    : stage.label === 'Dead'
                      ? 'bg-muted-foreground/40'
                      : 'bg-primary/70',
                ]}
                style={`width: ${(stage.value / funnelTotal) * 100}%`}
                title={`${stage.label}: ${stage.value}`}
              />
            ))
          }
        </div>
        <dl class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-5">
          {
            funnelStages.map((stage) => (
              <div>
                <dt class="text-xs tracking-wider text-muted-foreground uppercase">{stage.label}</dt>
                <dd class="mt-1 text-2xl font-semibold tabular-nums">{stage.value}</dd>
              </div>
            ))
          }
        </dl>
        <dl class="mt-5 grid gap-2 border-t border-border pt-4 text-sm sm:grid-cols-3">
          <div class="flex items-baseline justify-between gap-3">
            <dt class="text-muted-foreground">Research notes</dt>
            <dd class="tabular-nums">{pipeline.researchNotes}</dd>
          </div>
          <div class="flex items-baseline justify-between gap-3">
            <dt class="text-muted-foreground">Pending review</dt>
            <dd class="tabular-nums">{pipeline.pendingReview}</dd>
          </div>
          <div class="flex items-baseline justify-between gap-3">
            <dt class="text-muted-foreground">Approved, not published</dt>
            <dd class="tabular-nums">{pipeline.approvedNotPublished}</dd>
          </div>
        </dl>
      </div>

      <div class="grid gap-4 lg:grid-cols-2">
        <div class="rounded-xl border border-border bg-card p-6">
          <h4 class="text-sm font-medium">Next in the queue</h4>
          {
            topics.queued.length === 0 ? (
              <p class="mt-4 text-sm text-muted-foreground">
                The queue is empty. Agents will idle until new topics are added.
              </p>
            ) : (
              <ul class="mt-4 flex flex-col divide-y divide-border text-sm">
                {topics.queued.map((topic) => (
                  <li class="py-2">
                    <p class="truncate">{topic.title}</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                      {topic.category ?? 'uncategorised'}
                      {topic.keywords.length > 0 ? ` · ${topic.keywords.join(', ')}` : ''}
                    </p>
                  </li>
                ))}
              </ul>
            )
          }
          <a
            href="/dashboard/agents/topics"
            class="mt-4 inline-block text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
          >
            Manage the queue
          </a>
        </div>

        <div class="rounded-xl border border-border bg-card p-6">
          <h4 class="text-sm font-medium">Blocked topics</h4>
          {
            topics.blocked.length === 0 ? (
              <p class="mt-4 text-sm text-muted-foreground">
                Nothing is blocked. Every topic the agents picked had enough evidence to write.
              </p>
            ) : (
              <ul class="mt-4 flex flex-col divide-y divide-border text-sm">
                {topics.blocked.map((topic) => (
                  <li class="py-2">
                    <p class="truncate">{topic.title}</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                      {topic.note ?? 'No reason recorded'}
                    </p>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </div>

      <div class="rounded-xl border border-border bg-card p-6">
        <h4 class="text-sm font-medium">Activity and media</h4>
        <dl class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-5">
          <div>
            <dt class="text-xs tracking-wider text-muted-foreground uppercase">Activity 24h</dt>
            <dd class="mt-1 text-2xl font-semibold tabular-nums">{activity.last24h}</dd>
          </div>
          <div>
            <dt class="text-xs tracking-wider text-muted-foreground uppercase">Activity 7d</dt>
            <dd class="mt-1 text-2xl font-semibold tabular-nums">{activity.last7d}</dd>
          </div>
          <div>
            <dt class="text-xs tracking-wider text-muted-foreground uppercase">Activity total</dt>
            <dd class="mt-1 text-2xl font-semibold tabular-nums">{activity.total}</dd>
          </div>
          <div>
            <dt class="text-xs tracking-wider text-muted-foreground uppercase">Media files</dt>
            <dd class="mt-1 text-2xl font-semibold tabular-nums">{media.count}</dd>
          </div>
          <div>
            <dt class="text-xs tracking-wider text-muted-foreground uppercase">Media size</dt>
            <dd class="mt-1 text-2xl font-semibold tabular-nums">{mediaSize}</dd>
          </div>
        </dl>
      </div>
    </section>
  </div>
</DashboardLayout>
