---
import AgentList from '@/components/dashboard/agent-list';
import AgentFlow from '@/components/dashboard/agent-flow';
import AgentScorecard from '@/components/dashboard/agent-scorecard.astro';
import BudgetCard from '@/components/dashboard/budget-card';
import DeepSeekKeyCard from '@/components/dashboard/deepseek-key-card';
import PipelineRunButton from '@/components/dashboard/pipeline-run-button';
import SearchProviderCard from '@/components/dashboard/search-provider-card';
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { clampScorecardDays, loadAgentScorecard } from '@/lib/agents/scorecard';
import { resolveContentDatabase } from '@/lib/content/database';

export const prerender = false;

const days = clampScorecardDays(Number.parseInt(Astro.url.searchParams.get('days') ?? '', 10));
const database = await resolveContentDatabase();
const scorecardRows = database ? await loadAgentScorecard(database, { days }) : [];
---

<DashboardLayout title="Agents">
  <div class="flex flex-col gap-6">
    <PipelineRunButton client:load />
    <section aria-label="Agent pipeline flow">
      <AgentFlow client:load />
    </section>
    <AgentList client:load />
    <section aria-label="Agent performance scorecard">
      <AgentScorecard rows={scorecardRows} days={days} ranges={[7, 30, 90]} />
    </section>
    <section
      class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-border bg-card p-4"
      aria-label="Topic queue"
    >
      <div class="min-w-0">
        <h2 class="font-display text-lg font-bold tracking-[-0.02em] text-foreground">
          Topic queue
        </h2>
        <p class="mt-1 max-w-prose text-sm text-muted-foreground">
          Writer agents claim the oldest queued topic first. The scrapper agent stores research
          notes on a topic so the writer has evidence to work from.
        </p>
      </div>
      <a
        href="/dashboard/agents/topics"
        class="flex items-center justify-center whitespace-nowrap rounded-md bg-primary px-3 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
      >
        Open topics
      </a>
    </section>
    <DeepSeekKeyCard client:load />
    <SearchProviderCard client:load />
    <BudgetCard client:load />
  </div>
</DashboardLayout>
