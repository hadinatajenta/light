---
import AffiliateSettings from '@/components/dashboard/affiliate-settings';
import SettingsNav from '@/components/dashboard/settings-nav.astro';
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { SETTINGS_SECTION_AFFILIATE } from '@/lib/dashboard/settings-sections';

export const prerender = false;
---

<DashboardLayout title="Settings: Affiliate">
  <div class="flex flex-col gap-6">
    <div class="min-w-0">
      <h2 class="font-display text-lg font-bold tracking-[-0.02em] text-foreground">
        {SETTINGS_SECTION_AFFILIATE.label}
      </h2>
      <p class="mt-1 max-w-prose text-sm text-muted-foreground">
        {SETTINGS_SECTION_AFFILIATE.purpose}
      </p>
    </div>

    <SettingsNav />

    <AffiliateSettings client:load />
  </div>
</DashboardLayout>
