---
import ActivityFeed from '@/components/dashboard/activity-feed.astro';
import AgentLiveBoard from '@/components/dashboard/agent-live-board';
import AgentTimeline from '@/components/dashboard/agent-timeline';
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { listActivity, listActors, type ActorType } from '@/lib/activity/store';
import { type AgentLiveSnapshot, loadAgentLiveSnapshot } from '@/lib/agents/live';
import { resolveContentDatabase } from '@/lib/content/database';
import { formatRelativeTime } from '@/utils/date';

export const prerender = false;

const database = await resolveContentDatabase();

const typeParam = Astro.url.searchParams.get('type');
const actorType: ActorType | undefined =
  typeParam === 'user' || typeParam === 'agent' ? typeParam : undefined;
const actorId = Astro.url.searchParams.get('actor') ?? undefined;

const snapshot: AgentLiveSnapshot | null = database ? await loadAgentLiveSnapshot(database) : null;
const entries = database ? await listActivity(database, { actorType, actorId, limit: 100 }) : [];
const actors = database ? await listActors(database) : [];

const runningNow = snapshot?.running.length ?? 0;
const isLive = runningNow > 0;

const scopeFilters = [
  { label: 'All', href: '/dashboard/activity', isActive: !actorType && !actorId },
  {
    label: 'Users',
    href: '/dashboard/activity?type=user',
    isActive: actorType === 'user' && !actorId,
  },
  {
    label: 'Agents',
    href: '/dashboard/activity?type=agent',
    isActive: actorType === 'agent' && !actorId,
  },
];

const chipClass =
  'rounded-full border px-3 py-1.5 text-xs font-medium whitespace-nowrap transition-colors';
const activeChipClass = 'border-primary bg-primary text-primary-foreground';
const idleChipClass = 'border-border text-muted-foreground hover:bg-accent hover:text-foreground';
---

<DashboardLayout title="Activity">
  <div class="flex flex-col gap-6">
    <header class="flex flex-wrap items-center justify-between gap-3">
      <div class="min-w-0">
        <h2 class="font-display text-lg font-bold tracking-[-0.02em] text-foreground">Activity</h2>
        <p class="mt-0.5 text-xs text-muted-foreground tabular-nums">
          {
            snapshot
              ? `Generated ${formatRelativeTime(snapshot.generatedAt)}.`
              : 'Live data is unavailable right now.'
          }
        </p>
      </div>
      <p
        class:list={[
          'inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-medium',
          isLive ? 'border-primary/40 text-foreground' : 'border-border text-muted-foreground',
        ]}
      >
        <span
          class:list={[
            'size-1.5 rounded-full',
            isLive ? 'animate-pulse bg-primary motion-reduce:animate-none' : 'bg-muted-foreground',
          ]}
          aria-hidden="true"
        />
        {
          isLive
            ? `${runningNow} ${runningNow === 1 ? 'agent' : 'agents'} working now`
            : 'Idle right now'
        }
      </p>
    </header>

    <AgentLiveBoard client:load />

    <section
      aria-label="Recent agent runs"
      class="rounded-xl border border-border bg-card p-4 sm:p-6"
    >
      <div class="flex items-center gap-2">
        <h3 class="text-sm font-medium text-foreground">Recent runs</h3>
        <span class="text-xs text-muted-foreground tabular-nums">
          {snapshot ? snapshot.recent.length : 0}
        </span>
      </div>
      <p class="mt-1 max-w-prose text-sm text-muted-foreground">
        The last fifteen agent runs, newest first, with the outcome each one reported.
      </p>
      <div class="mt-4">
        <AgentTimeline runs={snapshot?.recent ?? []} />
      </div>
    </section>

    <section aria-label="Audit log" class="flex flex-col gap-4">
      <div>
        <h3 class="text-sm font-medium text-foreground">Activity log</h3>
        <p class="mt-1 max-w-prose text-sm text-muted-foreground">
          Every action you take in the CMS, and every event an agent reports, is recorded here.
          Filter by scope or by a single actor.
        </p>
      </div>

      <nav aria-label="Activity scope" class="flex flex-wrap items-center gap-2">
        {
          scopeFilters.map((filter) => (
            <a
              href={filter.href}
              aria-current={filter.isActive ? 'page' : undefined}
              class:list={[chipClass, filter.isActive ? activeChipClass : idleChipClass]}
            >
              {filter.label}
            </a>
          ))
        }
      </nav>

      {
        actors.length > 0 && (
          <nav aria-label="Activity actors" class="flex flex-wrap items-center gap-2">
            {actors.map((actor) => (
              <a
                href={`/dashboard/activity?actor=${encodeURIComponent(actor.id)}`}
                aria-current={actorId === actor.id ? 'page' : undefined}
                class:list={[chipClass, actorId === actor.id ? activeChipClass : idleChipClass]}
              >
                <span class="mr-1.5">{actor.type === 'agent' ? 'Agent' : 'User'}</span>
                {actor.label}
                <span class="ml-1.5 tabular-nums opacity-70">{actor.activityCount}</span>
              </a>
            ))}
          </nav>
        )
      }

      <section aria-label="Activity entries" class="rounded-lg border border-border bg-card px-4 py-2">
        <ActivityFeed entries={entries} />
      </section>
    </section>
  </div>
</DashboardLayout>
