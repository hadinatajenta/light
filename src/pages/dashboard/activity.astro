---
import ActivityLog from '@/components/dashboard/activity-log';
import AgentLiveBoard from '@/components/dashboard/agent-live-board';
import AgentTimeline from '@/components/dashboard/agent-timeline';
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { type AgentLiveSnapshot, loadAgentLiveSnapshot } from '@/lib/agents/live';
import { resolveContentDatabase } from '@/lib/content/database';
import { formatRelativeTime } from '@/utils/date';

export const prerender = false;

const database = await resolveContentDatabase();

const snapshot: AgentLiveSnapshot | null = database ? await loadAgentLiveSnapshot(database) : null;

const runningNow = snapshot?.running.length ?? 0;
const isLive = runningNow > 0;
---

<DashboardLayout title="Activity">
  <div class="flex flex-col gap-6">
    <header class="flex flex-wrap items-center justify-between gap-3">
      <div class="min-w-0">
        <h2 class="font-display text-lg font-bold tracking-[-0.02em] text-foreground">Activity</h2>
        <p class="mt-0.5 text-xs text-muted-foreground tabular-nums">
          {
            snapshot
              ? `Generated ${formatRelativeTime(snapshot.generatedAt)}.`
              : 'Live data is unavailable right now.'
          }
        </p>
      </div>
      <p
        class:list={[
          'inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-medium',
          isLive ? 'border-primary/40 text-foreground' : 'border-border text-muted-foreground',
        ]}
      >
        <span
          class:list={[
            'size-1.5 rounded-full',
            isLive ? 'animate-pulse bg-primary motion-reduce:animate-none' : 'bg-muted-foreground',
          ]}
          aria-hidden="true"
        />
        {
          isLive
            ? `${runningNow} ${runningNow === 1 ? 'agent' : 'agents'} working now`
            : 'Idle right now'
        }
      </p>
    </header>

    <AgentLiveBoard client:load />

    <section
      aria-label="Recent agent runs"
      class="rounded-xl border border-border bg-card p-4 sm:p-6"
    >
      <div class="flex items-center gap-2">
        <h3 class="text-sm font-medium text-foreground">Recent runs</h3>
        <span class="text-xs text-muted-foreground tabular-nums">
          {snapshot ? snapshot.recent.length : 0}
        </span>
      </div>
      <p class="mt-1 max-w-prose text-sm text-muted-foreground">
        The last fifteen agent runs, newest first, with the outcome each one reported.
      </p>
      <div class="mt-4">
        <AgentTimeline runs={snapshot?.recent ?? []} />
      </div>
    </section>

    <ActivityLog client:load />
  </div>
</DashboardLayout>
