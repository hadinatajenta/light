---
import ProductCatalog from '@/components/dashboard/product-catalog';
import DashboardLayout from '@/layouts/DashboardLayout.astro';

export const prerender = false;

const searchParams = Astro.url.searchParams;
const activeParam = searchParams.get('active');
const initialActive =
  activeParam === 'active' || activeParam === 'inactive' ? activeParam : 'all';
---

<DashboardLayout title="Product catalog">
  <ProductCatalog
    client:load
    initialQuery={searchParams.get('q') ?? ''}
    initialProgram={searchParams.get('program') ?? ''}
    initialActive={initialActive}
    initialPage={Math.max(1, Number.parseInt(searchParams.get('page') ?? '1', 10) || 1)}
  />
</DashboardLayout>
