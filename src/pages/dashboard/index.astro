---
import ActivityFeed from '@/components/dashboard/activity-feed.astro';
import { LineChart } from '@/components/dashboard/line-chart';
import Sparkline from '@/components/dashboard/sparkline.astro';
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { listActivity } from '@/lib/activity/store';
import { listCategories } from '@/lib/content/categories';
import { resolveContentDatabase } from '@/lib/content/database';
import { listPosts } from '@/lib/content/store';
import { buildDailySeries, countByRecency, formatDelta } from '@/lib/dashboard/metrics';
import { resolveMediaStore } from '@/lib/media/store';
import { formatDateRange, formatShortDate } from '@/utils/date';

export const prerender = false;

const PERIOD_DAYS = 30;
const DAY_IN_MS = 24 * 60 * 60 * 1000;
const ACTIVITY_PREVIEW_LIMIT = 6;

const posts = await listPosts();
const categories = await listCategories();
const mediaItems = await (await resolveMediaStore()).list();

const database = await resolveContentDatabase();
const recentActivity = database
  ? await listActivity(database, { limit: ACTIVITY_PREVIEW_LIMIT })
  : [];

const publishedPosts = posts.filter((post) => post.status === 'published');
const draftPosts = posts.filter((post) => post.status === 'draft');
const publishedDates = publishedPosts.map((post) => post.pubDate);

const publishedRecency = countByRecency(publishedDates, PERIOD_DAYS);
const draftRecency = countByRecency(
  draftPosts.map((post) => post.pubDate),
  PERIOD_DAYS,
);
const categoryRecency = countByRecency(
  categories.map((category) => category.createdAt),
  PERIOD_DAYS,
);
const mediaRecency = countByRecency(
  mediaItems.map((item) => item.createdAt),
  PERIOD_DAYS,
);

const hasCategoryDates = categories.some((category) => category.createdAt !== null);

function axisLabelsFor(days: number): Array<{ id: string; label: string }> {
  const end = Date.now();
  return [
    { id: 'start', label: formatShortDate(new Date(end - (days - 1) * DAY_IN_MS)) },
    {
      id: 'middle',
      label: formatShortDate(new Date(end - Math.floor((days - 1) / 2) * DAY_IN_MS)),
    },
    { id: 'end', label: formatShortDate(new Date(end)) },
  ];
}

const chartDatasets = [7, 30, 90].map((days) => ({
  id: `${days}d`,
  label: `${days}d`,
  values: buildDailySeries(publishedDates, days),
  axisLabels: axisLabelsFor(days),
}));

const secondaryMetrics = [
  {
    label: 'Drafts',
    value: draftPosts.length,
    delta: formatDelta(draftRecency.recent, draftRecency.previous),
    href: '/dashboard/posts?status=draft',
  },
  {
    label: 'Categories',
    value: categories.length,
    delta: hasCategoryDates ? formatDelta(categoryRecency.recent, categoryRecency.previous) : '-',
    href: '/dashboard/categories',
  },
  {
    label: 'Media',
    value: mediaItems.length,
    delta: formatDelta(mediaRecency.recent, mediaRecency.previous),
    href: '/dashboard/media',
  },
];

const periodEnd = new Date();
const periodStart = new Date(Date.now() - (PERIOD_DAYS - 1) * DAY_IN_MS);
const primaryDelta = `${formatDelta(publishedRecency.recent, publishedRecency.previous)} vs previous ${PERIOD_DAYS} days`;
---

<DashboardLayout title="Dashboard">
  <div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="text-lg font-semibold tracking-tight">Overview</h2>
      <p class="text-sm text-muted-foreground tabular-nums">
        {formatDateRange(periodStart, periodEnd)}
      </p>
    </div>

    <section aria-label="Key metrics" class="grid gap-4 lg:grid-cols-3">
      <article class="flex flex-col rounded-lg border border-border bg-card p-6 lg:col-span-2">
        <h3 class="text-xs font-medium tracking-wider text-muted-foreground uppercase">
          Published posts
        </h3>

        <div class="mt-4 flex items-end justify-between gap-6">
          <p class="text-6xl font-semibold tracking-tight tabular-nums">
            {publishedRecency.total}
          </p>
          <div class="w-36 shrink-0 pb-2 sm:w-44">
            <Sparkline
              values={buildDailySeries(publishedDates, PERIOD_DAYS)}
              label={`Posts published per day over the last ${PERIOD_DAYS} days`}
            />
          </div>
        </div>

        <p class="mt-3 text-sm text-muted-foreground tabular-nums">{primaryDelta}</p>

        <div class="mt-6 grid grid-cols-2 gap-4 border-t border-border pt-4">
          <div>
            <p class="text-xs tracking-wider text-muted-foreground uppercase">
              Last {PERIOD_DAYS} days
            </p>
            <p class="mt-1 text-2xl font-semibold tabular-nums">{publishedRecency.recent}</p>
          </div>
          <div>
            <p class="text-xs tracking-wider text-muted-foreground uppercase">Earlier</p>
            <p class="mt-1 text-2xl font-semibold tabular-nums">
              {publishedRecency.total - publishedRecency.recent}
            </p>
          </div>
        </div>
      </article>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3 lg:col-span-1 lg:grid-cols-1">
        {
          secondaryMetrics.map((metric) => (
            <a
              href={metric.href}
              class="flex flex-col justify-between rounded-lg border border-border bg-card p-5 transition-colors hover:border-foreground/25 hover:bg-accent/40"
            >
              <h3 class="text-xs font-medium tracking-wider text-muted-foreground uppercase">
                {metric.label}
              </h3>
              <div class="mt-2 flex items-baseline justify-between gap-3">
                <p class="text-3xl font-semibold tabular-nums">{metric.value}</p>
                <span class="text-xs text-muted-foreground tabular-nums">{metric.delta}</span>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <LineChart client:visible datasets={chartDatasets} defaultDatasetId="30d" />

    <section aria-label="Recent activity" class="rounded-lg border border-border bg-card p-6">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-sm font-medium">Recent activity</h2>
        <a
          href="/dashboard/activity"
          class="whitespace-nowrap text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
        >
          View all
        </a>
      </div>
      <div class="mt-2">
        <ActivityFeed entries={recentActivity} />
      </div>
    </section>
  </div>
</DashboardLayout>
