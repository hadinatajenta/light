---
import Sparkline from '@/components/dashboard/sparkline.astro';
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { listCategories } from '@/lib/content/categories';
import { listPosts } from '@/lib/content/store';
import { resolveMediaStore } from '@/lib/media/store';

export const prerender = false;

const WEEK_COUNT = 12;
const WEEK_IN_MS = 7 * 24 * 60 * 60 * 1000;

interface DatedPost {
  pubDate: string | null;
  updatedDate: string | null;
}

function buildWeeklySeries(posts: DatedPost[], weekCount: number): number[] {
  const now = Date.now();
  const buckets = Array.from({ length: weekCount }, () => 0);

  for (const post of posts) {
    const rawDate = post.pubDate ?? post.updatedDate;
    if (!rawDate) {
      continue;
    }

    const publishedAt = new Date(rawDate).getTime();
    if (Number.isNaN(publishedAt)) {
      continue;
    }

    const weeksAgo = Math.floor((now - publishedAt) / WEEK_IN_MS);
    if (weeksAgo < 0 || weeksAgo >= weekCount) {
      continue;
    }

    buckets[weekCount - 1 - weeksAgo] += 1;
  }

  return buckets;
}

const posts = await listPosts();
const categories = await listCategories();
const mediaItems = await (await resolveMediaStore()).list();

const publishedCount = posts.filter((post) => post.status === 'published').length;
const draftCount = posts.filter((post) => post.status === 'draft').length;
const weeklySeries = buildWeeklySeries(posts, WEEK_COUNT);
const weeklyTotal = weeklySeries.reduce((sum, value) => sum + value, 0);

const secondaryMetrics = [
  {
    label: 'Drafts',
    value: draftCount,
    period: 'All time',
    href: '/dashboard/posts?status=draft',
  },
  {
    label: 'Categories',
    value: categories.length,
    period: 'All time',
    href: '/dashboard/categories',
  },
  {
    label: 'Media',
    value: mediaItems.length,
    period: 'All time',
    href: '/dashboard/media',
  },
];
---

<DashboardLayout title="Dashboard">
  <section aria-labelledby="overview-heading" class="grid gap-4 lg:grid-cols-3">
    <h2 id="overview-heading" class="sr-only">Content overview</h2>

    <article class="flex flex-col rounded-lg border border-border bg-card p-6 lg:col-span-2">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h3 class="text-xs font-medium tracking-wider text-muted-foreground uppercase">
            Published posts
          </h3>
          <p class="mt-1 text-xs text-muted-foreground">All time</p>
        </div>
        <a
          href="/dashboard/posts?status=published"
          class="whitespace-nowrap text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
        >
          View posts
        </a>
      </div>

      <p class="mt-8 text-6xl font-semibold tracking-tight tabular-nums">{publishedCount}</p>

      <div class="mt-auto pt-8">
        <Sparkline
          values={weeklySeries}
          label={`Posts published per week over the last ${WEEK_COUNT} weeks`}
        />
        <p class="mt-2 text-xs text-muted-foreground tabular-nums">
          Last {WEEK_COUNT} weeks, {weeklyTotal} published
        </p>
      </div>
    </article>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3 lg:col-span-1 lg:grid-cols-1">
      {
        secondaryMetrics.map((metric) => (
          <a
            href={metric.href}
            class="flex flex-col rounded-lg border border-border bg-card p-4 transition-colors hover:border-foreground/25 hover:bg-accent/40"
          >
            <h3 class="text-xs font-medium tracking-wider text-muted-foreground uppercase">
              {metric.label}
            </h3>
            <p class="mt-2 text-3xl font-semibold tabular-nums">{metric.value}</p>
            <p class="mt-1 text-xs text-muted-foreground">{metric.period}</p>
          </a>
        ))
      }
    </div>
  </section>
</DashboardLayout>
