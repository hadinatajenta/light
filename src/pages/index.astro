---
import AdSlot from '@/components/AdSlot.astro';
import HomeIntro from '@/components/HomeIntro.astro';
import PostCard from '@/components/PostCard.astro';
import SponsoredBlock from '@/components/SponsoredBlock.astro';
import TopicTabs from '@/components/TopicTabs.astro';
import { SITE_DESCRIPTION, SITE_HOME_TITLE, SITE_TITLE, SOCIAL_PROFILES } from '@/consts';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedPostSummaries } from '@/lib/content/public';
import { buildTopics, topicLabel } from '@/lib/content/topics';
import { formatDate } from '@/utils/date';
import {
  buildCanonicalUrl,
  buildItemListJsonLd,
  buildOrganizationJsonLd,
  buildWebsiteJsonLd,
} from '@/utils/seo';

export const prerender = false;

const HOMEPAGE_POST_LIMIT = 12;

const siteUrl =
  buildCanonicalUrl(Astro.site ?? undefined, '/') ?? new URL('/', Astro.url.origin).href;

const publishedPosts = await getPublishedPostSummaries();
const posts = publishedPosts.slice(0, HOMEPAGE_POST_LIMIT);
const heroPost = posts[0] ?? null;
const leadPost = posts[1] ?? null;
const sidePosts = posts.slice(2, 6);
const gridPosts = posts.slice(6, 12);
const topics = buildTopics(publishedPosts).slice(0, 8);

const jsonLd = [
  buildWebsiteJsonLd({ name: SITE_TITLE, url: siteUrl, description: SITE_DESCRIPTION }),
  buildOrganizationJsonLd({
    name: SITE_TITLE,
    url: siteUrl,
    logoUrl: new URL('/og-default.png', siteUrl).href,
    sameAs: SOCIAL_PROFILES.map((profile) => profile.href),
  }),
  ...(posts.length > 0
    ? [
        buildItemListJsonLd(
          posts.map((post) => ({
            name: post.title,
            url: new URL(`/blog/${post.id}/`, siteUrl).href,
          })),
        ),
      ]
    : []),
];
---

<BaseLayout contained={false} title={SITE_HOME_TITLE} jsonLd={jsonLd}>
  <HomeIntro featured={heroPost} />
  <TopicTabs topics={topics} />

  {
    leadPost ? (
      <section class="home-latest" id="latest" aria-labelledby="home-latest-title">
        <div class="home-container">
          <div class="home-section-head">
            <div>
              <p class="home-kicker">The library</p>
              <h2 class="home-section-title" id="home-latest-title">
                Latest guides
              </h2>
            </div>
            <a class="home-text-link" href="/blog/">View all guides</a>
          </div>

          <div class="home-latest-layout">
            <PostCard post={leadPost} variant="lead" ordinal={2} headingLevel={3} />

            <ol class="home-compact-list">
              {sidePosts.map((post, index) => (
                <li>
                  <span class="home-list-num">{String(index + 3).padStart(2, '0')}</span>
                  <div>
                    <h3 class="home-list-title">
                      <a href={`/blog/${post.id}/`}>{post.title}</a>
                    </h3>
                    <p class="guide-meta">
                      <span>{topicLabel(post.category ?? post.tags[0] ?? 'guide')}</span>
                      {post.pubDate ? (
                        <>
                          <span class="guide-meta-dot" aria-hidden="true" />
                          <time datetime={post.pubDate}>
                            {formatDate(new Date(post.pubDate))}
                          </time>
                        </>
                      ) : null}
                    </p>
                  </div>
                </li>
              ))}
            </ol>
          </div>

          {gridPosts.length > 0 ? (
            <div class="home-guide-grid">
              {gridPosts.map((post, index) => (
                <PostCard post={post} ordinal={index + 7} headingLevel={3} />
              ))}
            </div>
          ) : null}

          <SponsoredBlock />
          <AdSlot slotId="home-top" format="leaderboard" />
        </div>
      </section>
    ) : (
      <section class="home-empty">
        <p>Guides are on the way. The first buying guides are being written and reviewed now.</p>
      </section>
    )
  }
</BaseLayout>
