---
import AdBanner from '@/components/AdBanner.astro';
import PostCard from '@/components/PostCard.astro';
import TopicTabs from '@/components/TopicTabs.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedPosts } from '@/utils/content';
import { buildCanonicalUrl, buildWebsiteJsonLd } from '@/utils/seo';

const posts = await getPublishedPosts();
const [featurePost, altPost, thirdPost, fourthPost, fifthPost, sixthPost, seventhPost] = posts;

const siteUrl =
  buildCanonicalUrl(Astro.site ?? undefined, '/') ?? new URL('/', Astro.url.origin).href;
const jsonLd = buildWebsiteJsonLd({
  name: SITE_TITLE,
  url: siteUrl,
  description: SITE_DESCRIPTION,
});
---

<BaseLayout contained={false} jsonLd={jsonLd}>
  <TopicTabs />

  <section class="mag-section">
    <div class="magazine">
      <div class="mag-col">
        {altPost && <PostCard post={altPost} symbol="¶" />}
        {fourthPost && <PostCard post={fourthPost} variant="text" />}
        {fifthPost && <PostCard post={fifthPost} symbol="△" />}
      </div>

      <div class="mag-col mag-col-feature">
        {featurePost && <PostCard post={featurePost} variant="feature" symbol="※" />}
        {thirdPost && <PostCard post={thirdPost} variant="alt" symbol="❦" />}
      </div>

      <div class="mag-col">
        {sixthPost && <PostCard post={sixthPost} variant="text" />}
        {seventhPost && <PostCard post={seventhPost} symbol="❋" />}
        <aside class="m-sponsored">
          <span class="sp-label">Partner</span>
          <h4>Sponsored placement</h4>
          <p>This slot is reserved for a vetted product recommendation from a partner.</p>
          <a class="btn btn-primary btn-sm" href="/affiliate-disclosure/">How we vet partners</a>
        </aside>
      </div>
    </div>
  </section>

  <AdBanner />
</BaseLayout>
