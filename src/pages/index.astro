---
import PostList from '@/components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedPosts } from '@/utils/content';
import { buildCanonicalUrl, buildWebsiteJsonLd } from '@/utils/seo';

const posts = await getPublishedPosts();
const recentPosts = posts.slice(0, 6);
const siteUrl = buildCanonicalUrl(Astro.site ?? undefined, '/') ?? new URL('/', Astro.url.origin).href;
const jsonLd = buildWebsiteJsonLd({
  name: SITE_TITLE,
  url: siteUrl,
  description: SITE_DESCRIPTION,
});
---

<BaseLayout jsonLd={jsonLd}>
  <section class="prose-measure">
    <h1 class="text-4xl font-semibold tracking-tight">Buying guides you can actually trust</h1>
    <p class="mt-4 text-lg text-ink-muted">{SITE_DESCRIPTION}</p>
    <p class="mt-4 text-ink-muted">
      Every guide is researched by hand and updated when products change. If a pick stops being
      worth your money, we say so.
    </p>
  </section>

  <section class="mt-12">
    <h2 class="text-2xl font-semibold tracking-tight">Latest guides</h2>
    <div class="mt-6">
      <PostList posts={recentPosts} />
    </div>
    <p class="mt-8">
      <a href="/blog/" class="text-accent-strong underline">Browse all guides</a>
    </p>
  </section>
</BaseLayout>
