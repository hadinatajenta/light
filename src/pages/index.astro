---
import AdSlot from '@/components/AdSlot.astro';
import HomeIntro from '@/components/HomeIntro.astro';
import PostCard from '@/components/PostCard.astro';
import RankedGuideList from '@/components/RankedGuideList.astro';
import TopicTabs from '@/components/TopicTabs.astro';
import { SITE_DESCRIPTION, SITE_HOME_TITLE, SITE_TITLE, SOCIAL_PROFILES } from '@/consts';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedPostSummaries } from '@/lib/content/public';
import { buildTopics, listPillarPosts } from '@/lib/content/topics';
import {
  buildCanonicalUrl,
  buildItemListJsonLd,
  buildOrganizationJsonLd,
  buildWebsiteJsonLd,
} from '@/utils/seo';

export const prerender = false;

const HOMEPAGE_POST_LIMIT = 12;

const siteUrl =
  buildCanonicalUrl(Astro.site ?? undefined, '/') ?? new URL('/', Astro.url.origin).href;

const publishedPosts = await getPublishedPostSummaries();
const posts = publishedPosts.slice(0, HOMEPAGE_POST_LIMIT);
const heroPost = posts[0] ?? null;
const rankedLatest = posts.slice(1, 9);
const gridPosts = posts.slice(1, 7);
const topics = buildTopics(publishedPosts).slice(0, 8);
const pillarPosts = listPillarPosts(publishedPosts);
const hasStartHere = pillarPosts.length > 0;
const hasLatestRanked = rankedLatest.length > 0;
const hasBothRankedTabs = hasStartHere && hasLatestRanked;

const jsonLd = [
  buildWebsiteJsonLd({ name: SITE_TITLE, url: siteUrl, description: SITE_DESCRIPTION }),
  buildOrganizationJsonLd({
    name: SITE_TITLE,
    url: siteUrl,
    logoUrl: new URL('/og-default.png', siteUrl).href,
    sameAs: SOCIAL_PROFILES.map((profile) => profile.href),
  }),
  ...(posts.length > 0
    ? [
        buildItemListJsonLd(
          posts.map((post) => ({
            name: post.title,
            url: new URL(`/blog/${post.id}/`, siteUrl).href,
          })),
        ),
      ]
    : []),
];
---

<BaseLayout contained={false} title={SITE_HOME_TITLE} jsonLd={jsonLd}>
  <HomeIntro featured={heroPost} />

  {
    (hasStartHere || hasLatestRanked) && (
      <section class="home-ranked" aria-labelledby="home-ranked-title">
        <div class="home-container">
          <div class="home-section-head">
            <div class="home-section-title-group">
              <h2 class="home-section-title" id="home-ranked-title">
                {hasStartHere ? 'Start here' : 'Latest'}
              </h2>
              {hasBothRankedTabs ? (
                <div class="home-tabs" role="tablist" aria-label="Guide collections">
                  <button
                    type="button"
                    role="tab"
                    id="tab-start-here"
                    class="home-tab"
                    aria-selected="true"
                    aria-controls="panel-start-here"
                    tabindex="0"
                  >
                    Start here
                  </button>
                  <button
                    type="button"
                    role="tab"
                    id="tab-latest"
                    class="home-tab"
                    aria-selected="false"
                    aria-controls="panel-latest"
                    tabindex="-1"
                  >
                    Latest
                  </button>
                </div>
              ) : null}
            </div>
            <a class="home-text-link" href="/blog/">
              View all guides
            </a>
          </div>

          {hasStartHere && (
            <div
              id="panel-start-here"
              role={hasBothRankedTabs ? 'tabpanel' : undefined}
              aria-labelledby={hasBothRankedTabs ? 'tab-start-here' : undefined}
            >
              <RankedGuideList posts={pillarPosts} />
            </div>
          )}

          {hasLatestRanked && (
            <div
              id="panel-latest"
              role={hasBothRankedTabs ? 'tabpanel' : undefined}
              aria-labelledby={hasBothRankedTabs ? 'tab-latest' : undefined}
              hidden={hasStartHere}
            >
              <RankedGuideList posts={rankedLatest} />
            </div>
          )}
        </div>
      </section>
    )
  }

  <TopicTabs topics={topics} />

  {
    gridPosts.length > 0 ? (
      <section class="home-latest" id="latest" aria-labelledby="home-latest-title">
        <div class="home-container">
          <div class="home-section-head">
            <h2 class="home-section-title" id="home-latest-title">
              Latest guides
            </h2>
            <a class="home-text-link" href="/blog/">
              All guides
            </a>
          </div>

          <div class="home-guide-grid">
            {gridPosts.map((post, index) => (
              <PostCard post={post} ordinal={index + 2} headingLevel={3} />
            ))}
          </div>

          <AdSlot slotId="home-top" format="leaderboard" />
        </div>
      </section>
    ) : posts.length === 0 ? (
      <section class="home-empty">
        <p>Guides are on the way. The first buying guides are being written and reviewed now.</p>
      </section>
    ) : null
  }

  <script>
    const tablist = document.querySelector<HTMLElement>('.home-tabs[role="tablist"]');
    if (tablist) {
      const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const titleNode = document.getElementById('home-ranked-title');

      const activateTab = (nextTab: HTMLButtonElement): void => {
        for (const tab of tabs) {
          const isSelected = tab === nextTab;
          const panelId = tab.getAttribute('aria-controls');
          const panel = panelId ? document.getElementById(panelId) : null;
          tab.setAttribute('aria-selected', String(isSelected));
          tab.tabIndex = isSelected ? 0 : -1;
          if (panel) {
            panel.hidden = !isSelected;
          }
        }
        if (titleNode && nextTab.textContent) {
          titleNode.textContent = nextTab.textContent.trim();
        }
      };

      for (const tab of tabs) {
        tab.addEventListener('click', () => activateTab(tab));
        tab.addEventListener('keydown', (event) => {
          const currentIndex = tabs.indexOf(tab);
          if (currentIndex === -1) {
            return;
          }

          let targetIndex = -1;
          if (event.key === 'ArrowRight') {
            targetIndex = (currentIndex + 1) % tabs.length;
          } else if (event.key === 'ArrowLeft') {
            targetIndex = (currentIndex - 1 + tabs.length) % tabs.length;
          } else if (event.key === 'Home') {
            targetIndex = 0;
          } else if (event.key === 'End') {
            targetIndex = tabs.length - 1;
          }

          if (targetIndex >= 0) {
            event.preventDefault();
            const target = tabs[targetIndex];
            activateTab(target);
            target.focus();
          }
        });
      }
    }
  </script>
</BaseLayout>
