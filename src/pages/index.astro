---
import AdSlot from '@/components/AdSlot.astro';
import HomeIntro from '@/components/HomeIntro.astro';
import PostCard from '@/components/PostCard.astro';
import SponsoredBlock from '@/components/SponsoredBlock.astro';
import TopicTabs from '@/components/TopicTabs.astro';
import { SITE_DESCRIPTION, SITE_HOME_TITLE, SITE_TITLE, SOCIAL_PROFILES } from '@/consts';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedPostSummaries } from '@/lib/content/public';
import { buildTopics } from '@/lib/content/topics';
import { buildCanonicalUrl, buildItemListJsonLd, buildOrganizationJsonLd, buildWebsiteJsonLd } from '@/utils/seo';

export const prerender = false;

const HOMEPAGE_POST_LIMIT = 8;
const MAGAZINE_MIN_POSTS = 8;
const FLOW_MIN_POSTS = 4;
const SYMBOLS = ['※', '¶', '❦', '△', '❋', '◇', '✦', '◈'];

const siteUrl =
  buildCanonicalUrl(Astro.site ?? undefined, '/') ?? new URL('/', Astro.url.origin).href;

const publishedPosts = await getPublishedPostSummaries();
const posts = publishedPosts.slice(0, HOMEPAGE_POST_LIMIT);
const topics = buildTopics(publishedPosts);

const jsonLd = [
  buildWebsiteJsonLd({ name: SITE_TITLE, url: siteUrl, description: SITE_DESCRIPTION }),
  buildOrganizationJsonLd({
    name: SITE_TITLE,
    url: siteUrl,
    logoUrl: new URL('/og-default.png', siteUrl).href,
    sameAs: SOCIAL_PROFILES.map((profile) => profile.href),
  }),
  ...(posts.length > 0
    ? [
        buildItemListJsonLd(
          posts.map((post) => ({
            name: post.title,
            url: new URL(`/blog/${post.id}/`, siteUrl).href,
          })),
        ),
      ]
    : []),
];

const layout = posts.length >= MAGAZINE_MIN_POSTS
  ? 'magazine'
  : posts.length >= FLOW_MIN_POSTS
    ? 'flow'
    : 'single';

function variantForRank(rank: number): 'feature' | 'default' {
  return rank === 1 ? 'feature' : 'default';
}
---

<BaseLayout contained={false} title={SITE_HOME_TITLE} jsonLd={jsonLd}>
  <HomeIntro />
  <TopicTabs topics={topics} />

  {
    posts.length === 0 && (
      <section class="home-empty">
        <p>Guides are on the way. The first buying guides are being written and reviewed now.</p>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section class="home-section" aria-label="Latest guides">
        <div class={`home-layout home-layout-${layout}`}>
          {posts.map((post, index) => (
            <div class={`home-slot home-slot-${index + 1}`}>
              <PostCard
                post={post}
                variant={variantForRank(index + 1)}
                headingLevel={2}
                symbol={SYMBOLS[index % SYMBOLS.length]}
                priority={index === 0}
              />
            </div>
          ))}
        </div>

        <p class="home-archive">
          <a href="/blog/">View all guides</a>
        </p>
      </section>
    )
  }

  <SponsoredBlock />
  <AdSlot slotId="home-top" format="leaderboard" />
</BaseLayout>

<style>
  .home-section {
    margin: 0 auto;
    max-width: 80rem;
    padding: 8px 24px 40px;
  }
  .home-empty {
    margin: 0 auto;
    max-width: 46rem;
    padding: 24px 24px 64px;
    text-align: center;
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--ink-60);
  }
  .home-slot {
    min-width: 0;
  }
  .home-layout-single {
    display: grid;
    gap: 52px;
    margin: 0 auto;
    max-width: 44rem;
  }
  .home-layout-flow {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 52px 40px;
    align-items: start;
  }
  .home-layout-flow .home-slot-1 {
    grid-column: 1 / -1;
  }
  .home-layout-magazine {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 52px 40px;
    align-items: stretch;
  }
  .home-layout-magazine .home-slot-1 {
    grid-column: span 2;
  }
  .home-archive {
    margin-top: 40px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .home-archive a {
    color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (max-width: 1024px) {
    .home-layout-magazine {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .home-layout-magazine .home-slot-1 {
      grid-column: span 1;
    }
  }
  @media (max-width: 680px) {
    .home-section {
      padding: 8px 20px 32px;
    }
    .home-layout-magazine,
    .home-layout-flow {
      display: flex;
      flex-direction: column;
      gap: 44px;
    }
  }
</style>
