---
import PostList from '@/components/PostList.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedPostSummaries } from '@/lib/content/public';
import {
  buildTopics,
  listTopicPosts,
  MIN_TOPIC_POSTS,
  topicContent,
  topicLabel,
} from '@/lib/content/topics';
import { buildBreadcrumbJsonLd, buildItemListJsonLd } from '@/utils/seo';

export const prerender = false;

const tag = Astro.params.tag ?? '';
const publishedPosts = await getPublishedPostSummaries();
const posts = listTopicPosts(publishedPosts, tag);
const content = topicContent(tag);
const label = topicLabel(tag);
const isThin = posts.length < MIN_TOPIC_POSTS;
const siblingTopics = buildTopics(publishedPosts)
  .filter((topic) => topic.slug !== tag)
  .slice(0, 6);

if (posts.length === 0) {
  Astro.response.status = 404;
}

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const topicUrl = new URL(`/tag/${tag}/`, siteUrl).href;
const jsonLd = [
  buildBreadcrumbJsonLd([
    { name: 'Home', url: new URL('/', siteUrl).href },
    { name: label, url: topicUrl },
  ]),
  ...(posts.length > 0
    ? [
        buildItemListJsonLd(
          posts.map((post) => ({
            name: post.title,
            url: new URL(`/blog/${post.id}/`, siteUrl).href,
          })),
        ),
      ]
    : []),
];
---

<BaseLayout
  title={content.title}
  description={content.description}
  noindex={isThin}
  jsonLd={jsonLd}
>
  <nav aria-label="Breadcrumb" class="font-sans text-[12px] tracking-[0.08em] uppercase text-ink-75">
    <a href="/" class="hover:text-ink">Home</a>
    <span aria-hidden="true"> / </span>
    <span>{label}</span>
  </nav>

  <header class="mt-4 max-w-2xl">
    <h1 class="text-3xl font-semibold tracking-tight">{label}</h1>
    <p class="mt-3 text-base leading-relaxed text-ink-75">{content.intro}</p>
    <p class="mt-3 font-sans text-[12px] tracking-[0.08em] uppercase tabular-nums text-ink-75">
      {posts.length} {posts.length === 1 ? 'guide' : 'guides'}
    </p>
  </header>

  <div class="mt-8">
    <PostList
      posts={posts}
      emptyMessage="No guides are filed under this topic yet. New guides appear here once they are published."
    />
  </div>

  {
    siblingTopics.length > 0 && (
      <section aria-label="Other topics" class="mt-14 border-t border-ink-12 pt-6">
        <h2 class="font-sans text-[12px] font-semibold tracking-[0.12em] uppercase text-ink-75">
          Other topics
        </h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {siblingTopics.map((topic) => (
            <li>
              <a
                href={`/tag/${topic.slug}/`}
                class="inline-flex items-center gap-2 rounded-full border border-ink-12 px-3 py-1.5 font-sans text-[13px] text-ink-75 transition-colors hover:border-ink-40 hover:text-ink"
              >
                {topic.label}
                <span class="tabular-nums text-ink-40">{topic.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
