---
import PostList from '@/components/PostList.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedPostSummaries } from '@/lib/content/public';

export const prerender = false;

const tag = Astro.params.tag ?? '';
const posts = (await getPublishedPostSummaries()).filter((post) => post.tags.includes(tag));
---

<BaseLayout title={`Tag: ${tag}`} description={`Articles tagged with ${tag}.`}>
  <h1 class="text-3xl font-semibold tracking-tight">Tag: {tag}</h1>
  <div class="mt-8">
    <PostList posts={posts} />
  </div>
</BaseLayout>
