---
import PostList from '@/components/PostList.astro';
import RankedGuideList from '@/components/RankedGuideList.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedPostSummaries } from '@/lib/content/public';
import {
  buildTopics,
  isIndexableTopic,
  listTopicPosts,
  splitPillarPosts,
  topicContent,
  topicLabel,
} from '@/lib/content/topics';
import { buildBreadcrumbJsonLd, buildItemListJsonLd } from '@/utils/seo';

export const prerender = false;

const tag = Astro.params.tag ?? '';
const publishedPosts = await getPublishedPostSummaries();
const posts = listTopicPosts(publishedPosts, tag);
const content = topicContent(tag);
const label = topicLabel(tag);
const introParagraphs = content.guideIntro ?? [content.intro];
const { pillarPosts, otherPosts } = splitPillarPosts(tag, posts);
const hasPillarPosts = pillarPosts.length > 0;
const orderedPosts = [...pillarPosts, ...otherPosts];
const siblingTopics = buildTopics(publishedPosts)
  .filter((topic) => topic.slug !== tag)
  .slice(0, 6);

if (posts.length === 0) {
  Astro.response.status = 404;
}

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const topicUrl = new URL(`/tag/${tag}/`, siteUrl).href;
const jsonLd = [
  buildBreadcrumbJsonLd([
    { name: 'Home', url: new URL('/', siteUrl).href },
    { name: label, url: topicUrl },
  ]),
  ...(posts.length > 0
    ? [
        buildItemListJsonLd(
          orderedPosts.map((post) => ({
            name: post.title,
            url: new URL(`/blog/${post.id}/`, siteUrl).href,
          })),
        ),
      ]
    : []),
];
---

<BaseLayout
  title={content.title}
  description={content.description}
  noindex={!isIndexableTopic(tag, posts.length)}
  jsonLd={jsonLd}
>
  <nav aria-label="Breadcrumb" class="hub-breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <span>{label}</span>
  </nav>

  <header class="hub-header">
    <h1 class="hub-title">{label}</h1>
    {
      introParagraphs.map((paragraph) => (
        <p class="hub-intro">{paragraph}</p>
      ))
    }
    <p class="hub-meta">
      <span class="topic-chip numeric">
        {posts.length} {posts.length === 1 ? 'guide' : 'guides'}
      </span>
    </p>
  </header>

  {
    hasPillarPosts && (
      <section aria-labelledby="topic-start-here" class="hub-section">
        <h2 id="topic-start-here" class="hub-section-title">
          Start here
        </h2>
        <RankedGuideList posts={pillarPosts} />
      </section>
    )
  }

  {
    otherPosts.length > 0 && (
      <section aria-labelledby="topic-all-guides" class="hub-section">
        <h2 id="topic-all-guides" class="hub-section-title">
          All {label} guides
        </h2>
        <PostList posts={otherPosts} />
      </section>
    )
  }

  {
    posts.length === 0 && (
      <div class="hub-section">
        <PostList
          posts={posts}
          emptyMessage="No guides are filed under this topic yet. New guides appear here once they are published."
        />
      </div>
    )
  }

  {
    siblingTopics.length > 0 && (
      <section aria-label="Other topics" class="hub-section border-t border-ink-12 pt-8">
        <h2 class="label">Other topics</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {siblingTopics.map((topic) => (
            <li>
              <a href={`/tag/${topic.slug}/`} class="topic-chip">
                <span>{topic.label}</span>
                <span class="numeric text-ink-65">{topic.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
