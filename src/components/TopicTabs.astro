---
import { TOPICS } from '@/consts';

interface Props {
  activeSlug?: string;
}

const { activeSlug } = Astro.props;
const isHome = activeSlug === undefined;
const latestHref = isHome ? '/' : '/blog/';
---

<div class="tabs-wrap">
  <nav class="tabs" aria-label="Topics">
    <a class="tab" href={latestHref} aria-current={isHome ? 'page' : undefined}>Latest</a>
    {
      TOPICS.map((topic) => (
        <a
          class="tab"
          href={`/tag/${topic.slug}/`}
          aria-current={topic.slug === activeSlug ? 'page' : undefined}
        >
          {topic.label}
        </a>
      ))
    }
  </nav>
</div>

<style>
  .tabs {
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 24px,
      #000 calc(100% - 24px),
      transparent 100%
    );
  }
</style>
