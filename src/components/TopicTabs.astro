---
import type { TopicLink } from '@/lib/content/topics';

interface Props {
  topics: TopicLink[];
  activeSlug?: string;
}

const { topics, activeSlug } = Astro.props;
const visibleTopics = topics.slice(0, 8);
---

<section class="home-topics" aria-label="Browse by topic">
  <div class="home-container home-topics-inner">
    <p class="home-kicker home-kicker-muted">Browse by topic</p>
    <nav class="home-topic-list" aria-label="Topics">
      {
        visibleTopics.map((topic) => (
          <a
            href={`/tag/${topic.slug}/`}
            aria-current={topic.slug === activeSlug ? 'page' : undefined}
          >
            {topic.label}
          </a>
        ))
      }
    </nav>
  </div>
</section>
