---
interface TopicLink {
  slug: string;
  label: string;
  count: number;
}

interface Props {
  topics: TopicLink[];
  activeSlug?: string;
}

const { topics, activeSlug } = Astro.props;
const isHome = activeSlug === undefined;
const latestHref = isHome ? '/' : '/blog/';
---

<div class="tabs-wrap">
  <nav class="tabs" aria-label="Topics">
    <a class="tab" href={latestHref} aria-current={isHome ? 'page' : undefined}>Latest</a>
    {
      topics.map((topic) => (
        <a
          class="tab"
          href={`/tag/${topic.slug}/`}
          aria-current={topic.slug === activeSlug ? 'page' : undefined}
        >
          {topic.label}
          {topic.count > 0 && (
            <span class="tab-count" aria-hidden="true">
              {topic.count}
            </span>
          )}
        </a>
      ))
    }
  </nav>
</div>

<style>
  .tabs {
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 24px,
      #000 calc(100% - 24px),
      transparent 100%
    );
  }
  .tab-count {
    margin-left: 6px;
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    color: var(--ink-40);
  }
  .tab[aria-current='page'] .tab-count {
    color: inherit;
  }
</style>
