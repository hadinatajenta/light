---
import type { ActivityEntry } from '@/lib/activity/store';
import { formatRelativeTime } from '@/utils/date';

interface Props {
  entries: ActivityEntry[];
  emptyMessage?: string;
}

const {
  entries,
  emptyMessage = 'No activity yet. Actions you take here, and events your agents report, will appear in this list.',
} = Astro.props;

function initialsOf(label: string): string {
  const parts = label.split(/[\s@._-]+/).filter(Boolean);
  if (parts.length === 0) {
    return '?';
  }

  return parts
    .slice(0, 2)
    .map((part) => part.charAt(0).toUpperCase())
    .join('');
}
---

{
  entries.length === 0 ? (
    <p class="rounded-lg border border-dashed border-border p-6 text-sm text-muted-foreground">
      {emptyMessage}
    </p>
  ) : (
    <ul class="divide-y divide-border">
      {entries.map((entry) => (
        <li class="flex items-start gap-3 py-3">
          <span
            class:list={[
              'grid size-8 shrink-0 place-items-center rounded-full text-xs font-medium',
              entry.actorType === 'agent'
                ? 'bg-chart-1/15 text-chart-1'
                : 'bg-chart-2/15 text-chart-2',
            ]}
            aria-hidden="true"
          >
            {initialsOf(entry.actorLabel)}
          </span>
          <div class="min-w-0 flex-1">
            <p class="flex items-baseline gap-2 text-sm">
              <span class="truncate font-medium">{entry.actorLabel}</span>
              <span class="text-xs text-muted-foreground">{entry.actorType}</span>
            </p>
            <p class="mt-0.5 text-sm text-muted-foreground">{entry.summary}</p>
          </div>
          <time
            class="shrink-0 text-xs text-muted-foreground tabular-nums"
            datetime={entry.createdAt}
          >
            {formatRelativeTime(entry.createdAt)}
          </time>
        </li>
      ))}
    </ul>
  )
}
