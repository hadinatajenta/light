---
import { buildChartPoints, toPolylinePoints } from '@/lib/chart';

interface Props {
  values: number[];
  width?: number;
  height?: number;
  label: string;
}

const { values, width = 240, height = 56, label } = Astro.props;

const sparklinePadding = 4;
const points = buildChartPoints(
  values,
  { x0: 0, y0: sparklinePadding, width, height: height - sparklinePadding * 2 },
  Math.max(1, ...values),
);
const linePoints = toPolylinePoints(points);
const areaPoints = `${linePoints} ${width},${height} 0,${height}`;
---

<svg
  viewBox={`0 0 ${width} ${height}`}
  preserveAspectRatio="none"
  class="block h-14 w-full text-chart-2"
  role="img"
  aria-label={label}
>
  <polygon points={areaPoints} fill="currentColor" opacity="0.1"></polygon>
  <polyline
    points={linePoints}
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    vector-effect="non-scaling-stroke"
  ></polyline>
</svg>
