---
import { SETTINGS_SECTIONS } from '@/lib/dashboard/settings-sections';

const rawPath = Astro.url.pathname;
const currentPath = rawPath.length > 1 ? rawPath.replace(/\/+$/, '') : rawPath;
---

<nav aria-label="Settings sections" class="border-b border-border">
  <ul class="flex flex-wrap gap-1">
    {
      SETTINGS_SECTIONS.map((section) => {
        const isCurrent = section.href === currentPath;

        return (
          <li>
            <a
              href={section.href}
              aria-current={isCurrent ? 'page' : undefined}
              class:list={[
                'inline-flex min-h-11 items-center rounded-t-md px-3 text-sm whitespace-nowrap transition-colors focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none sm:min-h-9',
                isCurrent
                  ? 'bg-[var(--brand-soft)] font-medium text-[var(--brand-strong)] shadow-[inset_0_-2px_0_var(--brand)]'
                  : 'text-muted-foreground hover:bg-accent hover:text-foreground',
              ]}
            >
              {section.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
