---
import type { AgentScorecard } from '@/lib/agents/scorecard';
import { formatRelativeTime } from '@/utils/date';

interface Props {
  rows: AgentScorecard[];
  days: number;
  ranges: number[];
}

const { rows, days, ranges } = Astro.props;

const ROLE_LABELS: Record<string, string> = {
  planner: 'Planner',
  writer: 'Writer',
  reviewer: 'Reviewer',
  qc: 'QC',
  scrapper: 'Scrapper',
};

function roleLabel(role: string): string {
  return ROLE_LABELS[role] ?? role;
}

const COMPACT_FORMATTER = new Intl.NumberFormat('en-US', {
  notation: 'compact',
  maximumFractionDigits: 1,
});

function formatCompact(value: number): string {
  return COMPACT_FORMATTER.format(value);
}

function formatSuccessRate(rate: number): string {
  return `${Math.round(rate * 100)}%`;
}

function formatTokensPerArticle(value: number | null): string {
  return value === null ? 'No articles yet' : formatCompact(Math.round(value));
}
---

<div class="flex flex-col gap-4">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div class="min-w-0">
      <h2 class="font-display text-lg font-bold tracking-[-0.02em] text-foreground">Performance</h2>
      <p class="mt-1 max-w-prose text-sm text-muted-foreground">
        Runs, tokens, topics, and reviews recorded in the last {days}
        {days === 1 ? 'day' : 'days'}.
      </p>
    </div>
    <nav class="flex items-center gap-1" aria-label="Scorecard range">
      {
        ranges.map((range) => (
          <a
            href={`?days=${range}`}
            aria-current={range === days ? 'page' : undefined}
            class:list={[
              'inline-flex items-center rounded-full px-3 py-1.5 text-xs font-medium whitespace-nowrap transition-colors focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none',
              range === days
                ? 'bg-primary text-primary-foreground'
                : 'border border-border text-muted-foreground hover:text-foreground',
            ]}
          >
            {range} days
          </a>
        ))
      }
    </nav>
  </div>

  {
    rows.length === 0 ? (
      <p class="rounded-lg border border-dashed border-border p-6 text-sm text-muted-foreground">
        No agents yet. Create an agent to start tracking runs, tokens, topics, and reviews.
      </p>
    ) : (
      <div class="overflow-x-auto rounded-xl border border-border bg-card">
        <table class="w-full min-w-[56rem] border-collapse text-sm">
          <caption class="border-b border-border px-4 py-3 text-left text-xs text-muted-foreground">
            Runs are ok and failed runs in the window, tokens are in and out, articles are topics
            this agent claimed and used, and reviews are drafts it reviewed, approved, and sent back
            for changes.
          </caption>
          <thead>
            <tr class="border-b border-border text-left text-[0.6875rem] tracking-[0.08em] uppercase text-muted-foreground">
              <th scope="col" class="px-4 py-3 font-medium">
                Agent
              </th>
              <th scope="col" class="px-4 py-3 font-medium">
                Runs
              </th>
              <th scope="col" class="px-4 py-3 font-medium">
                Success
              </th>
              <th scope="col" class="px-4 py-3 font-medium">
                Tokens
              </th>
              <th scope="col" class="px-4 py-3 font-medium">
                Articles
              </th>
              <th scope="col" class="px-4 py-3 font-medium">
                Tokens / article
              </th>
              <th scope="col" class="px-4 py-3 font-medium">
                Reviews
              </th>
              <th scope="col" class="px-4 py-3 font-medium">
                Last run
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {rows.map((row) => (
              <tr class="align-top">
                <th scope="row" class="px-4 py-3 text-left font-normal">
                  <div class="flex flex-col gap-1">
                    <span class="font-medium text-foreground">{row.name}</span>
                    <span class="flex flex-wrap items-center gap-1.5">
                      <span class="inline-flex items-center rounded-full border border-border px-2 py-0.5 text-[0.625rem] tracking-[0.08em] uppercase text-muted-foreground">
                        {roleLabel(row.role)}
                      </span>
                      {row.category ? (
                        <span class="font-mono text-xs text-muted-foreground">{row.category}</span>
                      ) : null}
                      {row.enabled ? null : (
                        <span class="text-xs text-muted-foreground">Disabled</span>
                      )}
                    </span>
                  </div>
                </th>
                <td class="px-4 py-3 tabular-nums">
                  <span class="text-foreground">{row.runsOk}</span>
                  <span class="text-muted-foreground"> / </span>
                  <span class="text-destructive">{row.runsFailed}</span>
                  <span class="text-muted-foreground"> of {row.runsTotal}</span>
                </td>
                <td class="px-4 py-3 tabular-nums text-foreground">
                  {formatSuccessRate(row.successRate)}
                </td>
                <td class="px-4 py-3 tabular-nums text-muted-foreground">
                  {formatCompact(row.tokensIn)} in · {formatCompact(row.tokensOut)} out
                </td>
                <td class="px-4 py-3 tabular-nums text-foreground">
                  <span>{row.articlesUsed} used</span>
                  {row.topicsClaimed > 0 || row.topicsProposed > 0 ? (
                    <span class="block text-xs text-muted-foreground">
                      {row.topicsClaimed} claimed · {row.topicsProposed} proposed
                    </span>
                  ) : null}
                </td>
                <td class="px-4 py-3 tabular-nums text-muted-foreground">
                  {formatTokensPerArticle(row.tokensPerArticle)}
                </td>
                <td class="px-4 py-3 tabular-nums text-foreground">
                  <span>{row.postsReviewed} reviewed</span>
                  {row.postsReviewed > 0 ? (
                    <span class="block text-xs text-muted-foreground">
                      {row.postsApproved} approved · {row.revisionsRequested} changes requested
                    </span>
                  ) : null}
                </td>
                <td class="px-4 py-3 text-muted-foreground">
                  {row.lastRunAt ? (
                    <time datetime={row.lastRunAt}>{formatRelativeTime(row.lastRunAt)}</time>
                  ) : (
                    'Never'
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</div>
