---
import type { SitePostSummary } from '@/lib/content/public';
import { topicLabel } from '@/lib/content/topics';
import { formatDate } from '@/utils/date';

interface Props {
  featured: SitePostSummary | null;
}

const { featured } = Astro.props;
const featuredLabel = featured ? topicLabel(featured.category ?? featured.tags[0] ?? 'guide') : '';
const featuredHref = featured ? `/blog/${featured.id}/` : '/blog/';
const hasCover = Boolean(featured?.coverUrl);
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="home-container home-hero-inner">
    <div class="home-hero-copy">
      <p class="home-kicker">Independent home-office research</p>
      <h1 class="home-hero-title" id="home-hero-title">
        Buying guides that hold up after the unboxing.
      </h1>
      <p class="home-hero-standfirst">
        Desk, chair, monitor, and lighting research written from primary sources, measured before it
        is recommended, and reviewed before it is published.
      </p>
      <div class="home-hero-actions">
        <a class="btn btn-primary" href="/blog/">Read the latest guides</a>
        <a class="btn btn-outline" href="/editorial-standards/">How we research</a>
      </div>
      <ul class="home-proof">
        <li>Every guide cites its sources</li>
      </ul>
    </div>

    {
      featured ? (
        <aside class="home-featured" aria-label="Featured guide">
          <div
            class={
              hasCover ? 'guide-plate home-featured-plate has-image' : 'guide-plate home-featured-plate'
            }
          >
            <span class="guide-plate-num">01</span>
            {hasCover ? (
              <img
                src={featured.coverUrl ?? ''}
                alt={featured.coverAlt ?? ''}
                width={1280}
                height={960}
                loading="eager"
                decoding="async"
                fetchpriority="high"
                class="guide-plate-image"
              />
            ) : (
              <span class="guide-plate-mark">{featuredLabel}</span>
            )}
            {hasCover ? <span class="guide-plate-cat">{featuredLabel}</span> : null}
          </div>
          <div class="home-featured-body">
            <p class="guide-meta">
              <span>{featuredLabel}</span>
              {
                featured.pubDate ? (
                  <>
                    <span class="guide-meta-dot" aria-hidden="true" />
                    <time datetime={featured.pubDate}>
                      {formatDate(new Date(featured.pubDate))}
                    </time>
                  </>
                ) : null
              }
            </p>
            <h2 class="home-featured-title">
              <a href={featuredHref}>{featured.title}</a>
            </h2>
            {featured.description ? (
              <p class="home-featured-excerpt">{featured.description}</p>
            ) : null}
            <a class="home-read-link" href={featuredHref}>Read the guide</a>
          </div>
        </aside>
      ) : null
    }
  </div>
</section>
