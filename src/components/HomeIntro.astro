---
import { SITE_DESCRIPTION } from '@/consts';
import type { SitePostSummary } from '@/lib/content/public';
import { topicLabel } from '@/lib/content/topics';
import { formatDate } from '@/utils/date';

interface Props {
  featured: SitePostSummary | null;
}

const { featured } = Astro.props;
const topicSlug = featured ? (featured.category ?? featured.tags[0]) : undefined;
const featuredLabel = featured ? topicLabel(topicSlug ?? 'guide') : '';
const featuredHref = featured ? `/blog/${featured.id}/` : '/blog/';
const hasCover = Boolean(featured?.coverUrl);
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="home-container home-hero-inner">
    {
      featured ? (
        <>
          <div class="home-hero-copy">
            <div class="home-hero-meta">
              <span class="home-kicker">Featured guide</span>
              {topicSlug ? (
                <a class="topic-chip" href={`/tag/${topicSlug}/`}>
                  {featuredLabel}
                </a>
              ) : (
                <span class="topic-chip">{featuredLabel}</span>
              )}
              {featured.pubDate ? (
                <time class="home-hero-date" datetime={featured.pubDate}>
                  {formatDate(new Date(featured.pubDate))}
                </time>
              ) : null}
            </div>
            <h1 class="home-hero-title" id="home-hero-title">
              {featured.title}
            </h1>
            {featured.description ? (
              <p class="home-hero-standfirst">{featured.description}</p>
            ) : null}
            <div class="home-hero-actions">
              <a class="btn btn-primary" href={featuredHref}>
                Read the guide
              </a>
              <a class="btn btn-outline" href="/blog/">
                All guides
              </a>
            </div>
          </div>

          <div class="home-hero-media">
            {hasCover ? (
              <img
                src={featured.coverUrl ?? ''}
                alt={featured.coverAlt ?? featured.title}
                width={1280}
                height={800}
                loading="eager"
                decoding="async"
                fetchpriority="high"
                class="home-hero-image"
              />
            ) : (
              <div class="home-hero-fallback">
                <span>{featuredLabel}</span>
              </div>
            )}
          </div>
        </>
      ) : (
        <div class="home-hero-copy">
          <p class="home-kicker">Buying guides</p>
          <h1 class="home-hero-title" id="home-hero-title">
            Desk gear and work device buying guides.
          </h1>
          <p class="home-hero-standfirst">{SITE_DESCRIPTION}</p>
          <div class="home-hero-actions">
            <a class="btn btn-primary" href="/blog/">
              All guides
            </a>
          </div>
        </div>
      )
    }
  </div>
</section>
