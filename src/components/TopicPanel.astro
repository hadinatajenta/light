---
import { PRIMARY_NAVIGATION } from '@/consts';
import type { TopicLink } from '@/lib/content/topics';

interface Props {
  topics: TopicLink[];
}

const { topics } = Astro.props;
---

<div class="topic-panel" id="topic-panel">
  <div class="topic-inner">
    <div class="topic-head">
      <span class="label">All topics</span>
      <span class="label topic-count">{topics.length} topics</span>
      <button type="button" class="topic-close" data-topics-trigger aria-label="Close menu">
        Close
      </button>
    </div>
    <div class="topic-grid">
      {
        topics.map((topic) => (
          <a class="topic-item" href={`/tag/${topic.slug}/`}>
            <span>{topic.label}</span>
            {topic.count > 0 && (
              <span class="topic-item-count" aria-hidden="true">
                {topic.count}
              </span>
            )}
            <span class="arw" aria-hidden="true">
              &rarr;
            </span>
          </a>
        ))
      }
    </div>
    <div class="topic-mobile-links">
      {
        PRIMARY_NAVIGATION.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))
      }
    </div>
  </div>
</div>

<script>
  const panel = document.getElementById('topic-panel');
  const triggers = Array.from(document.querySelectorAll('[data-topics-trigger]'));
  const mobileQuery = window.matchMedia('(max-width: 860px)');

  if (panel && triggers.length > 0) {
    let lastTrigger: HTMLElement | null = null;

    const setOpen = (isOpen: boolean): void => {
      panel.classList.toggle('open', isOpen);
      for (const trigger of triggers) {
        trigger.setAttribute('aria-expanded', String(isOpen));
      }
      document.body.style.overflow = isOpen && mobileQuery.matches ? 'hidden' : '';
    };

    for (const trigger of triggers) {
      trigger.addEventListener('click', (event) => {
        event.stopPropagation();
        const willOpen = !panel.classList.contains('open');

        if (willOpen) {
          lastTrigger = event.currentTarget instanceof HTMLElement ? event.currentTarget : null;
        }

        setOpen(willOpen);

        if (willOpen && mobileQuery.matches) {
          document.querySelector<HTMLElement>('.topic-close')?.focus();
        } else if (!willOpen && lastTrigger) {
          lastTrigger.focus();
        }
      });
    }

    panel.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) {
        setOpen(false);
      }
    });

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) {
        return;
      }
      if (panel.contains(event.target) || event.target.closest('[data-topics-trigger]')) {
        return;
      }
      setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setOpen(false);
      }
    });

    mobileQuery.addEventListener('change', () => {
      document.body.style.overflow = '';
    });
  }
</script>
