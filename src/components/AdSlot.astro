---
import { AD_CONFIG } from '@/config/monetization';

interface Props {
  slotId: string;
  format?: 'leaderboard' | 'rectangle' | 'rail';
  label?: string;
}

const { slotId, format = 'leaderboard', label = 'Advertisement' } = Astro.props;

const slot = AD_CONFIG.slots[slotId];
const isLive =
  AD_CONFIG.network === 'adsense' && Boolean(AD_CONFIG.adsenseClientId) && Boolean(slot);
---

{
  isLive ? (
    <aside class:list={['ad-slot', `ad-slot-${format}`]} aria-label={label}>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={AD_CONFIG.adsenseClientId}
        data-ad-slot={slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script is:inline>
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </aside>
  ) : null
}
