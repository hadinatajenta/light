---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@/utils/date';

interface Props {
  post: CollectionEntry<'blog'>;
  variant?: 'default' | 'feature' | 'text' | 'alt';
  symbol?: string;
}

const { post, variant = 'default', symbol } = Astro.props;
const { title, description, pubDate, tags, cover } = post.data;

const isTextOnly = variant === 'text';
const cardClass = ['m-card', variant === 'feature' ? 'm-card-feature' : '', isTextOnly ? 'm-card-text' : '']
  .filter(Boolean)
  .join(' ');
const mediaClass = variant === 'alt' ? 'm-card-media alt' : 'm-card-media';
const glyphClass = variant === 'alt' || isTextOnly ? 'sym-sm' : 'sym';
const glyph = symbol ?? (tags[0] ? tags[0].charAt(0).toUpperCase() : 'L');
const postHref = `/blog/${post.id}/`;
---

<article class={cardClass}>
  {
    !isTextOnly && (
      <div class={mediaClass} aria-hidden="true">
        {cover ? (
          <Image src={cover} alt="" loading="lazy" class="m-card-image" />
        ) : (
          <span class={glyphClass}>{glyph}</span>
        )}
      </div>
    )
  }
  <h3 class="m-card-title">
    <a href={postHref}>{title}</a>
  </h3>
  <div class="m-card-rule"></div>
  <p class="m-card-desc">{description}</p>
  <div class="m-card-meta">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
  </div>
  {
    tags.length > 0 && (
      <div class="m-card-tags">
        {tags.map((tag) => (
          <span>#{tag}</span>
        ))}
      </div>
    )
  }
</article>
