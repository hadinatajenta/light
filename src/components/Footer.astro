---
import { FOOTER_SECTIONS, SITE_AUTHOR, SITE_TAGLINE, SITE_TITLE } from '@/consts';
import { getRequestFooterPages } from '@/lib/settings/request';

const currentYear = new Date().getFullYear();
const fallbackLegalLinks = FOOTER_SECTIONS.find((section) => section.title === 'Legal')?.links ?? [];
const footerPages = await getRequestFooterPages(Astro.locals);
const legalLinks =
  footerPages.length > 0
    ? footerPages.map((page) => ({ label: page.title, href: `/${page.id}/` }))
    : fallbackLegalLinks;

const footerSections = FOOTER_SECTIONS.map((section) =>
  section.title === 'Legal' ? { ...section, links: legalLinks } : section,
);
---

<footer class="foot">
  <div class="foot-inner">
    <div class="foot-col foot-brand">
      <span class="brand">{SITE_TITLE}<span class="brand-mark">.</span></span>
      <p>{SITE_TAGLINE}</p>
    </div>
    {
      footerSections.map((section) => (
        <div class="foot-col">
          <h2>{section.title}</h2>
          {section.links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </div>
      ))
    }
  </div>
  <div class="foot-legal">
    <span>&copy; {currentYear} {SITE_TITLE}.</span>
    <span>Written by {SITE_AUTHOR}.</span>
  </div>
</footer>
