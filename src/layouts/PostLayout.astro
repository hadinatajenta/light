---
import AdSlot from '@/components/AdSlot.astro';
import { DEFAULT_AFFILIATE_DISCLOSURE } from '@/config/monetization';
import { SITE_AUTHOR } from '@/consts';
import { extractHeadings, formatReadingTime, renderMarkdown, type SitePost } from '@/lib/content/public';
import { findMediaCreditByUrl } from '@/lib/media/store';
import { formatDate } from '@/utils/date';
import { buildArticleJsonLd, buildBreadcrumbJsonLd, buildCanonicalUrl, buildFaqJsonLd } from '@/utils/seo';
import { buildTableOfContents } from '@/utils/toc';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: SitePost;
  affiliateLinks?: Map<string, string>;
  affiliateDisclosure?: string;
}

const {
  post,
  affiliateLinks = new Map<string, string>(),
  affiliateDisclosure,
} = Astro.props;

const rendered = renderMarkdown(post.body, affiliateLinks);
const html = rendered.html;
const showsAffiliateDisclosure = post.affiliate || rendered.affiliateLinks > 0;
const disclosureText = affiliateDisclosure || DEFAULT_AFFILIATE_DISCLOSURE;
const tableOfContents = buildTableOfContents(extractHeadings(post.body));
const readingMinutes = formatReadingTime(post.body);
const primaryTag = post.tags[0] ?? 'guide';
const authorInitials = SITE_AUTHOR.split(' ')
  .map((word) => word.charAt(0))
  .slice(0, 2)
  .join('')
  .toUpperCase();

const coverCredit = post.coverUrl ? await findMediaCreditByUrl(post.coverUrl) : null;

const canonicalUrl =
  buildCanonicalUrl(Astro.site ?? undefined, Astro.url.pathname) ?? Astro.url.pathname;
const publishedDate = post.pubDate ? new Date(post.pubDate) : new Date();
const jsonLd = [
  buildArticleJsonLd({
    title: post.title,
    description: post.description,
    url: canonicalUrl,
    datePublished: publishedDate,
    authorName: SITE_AUTHOR,
  }),
  buildBreadcrumbJsonLd([
    { name: 'Home', url: new URL('/', Astro.site ?? Astro.url.origin).href },
    { name: 'Guides', url: new URL('/blog/', Astro.site ?? Astro.url.origin).href },
    { name: post.title, url: canonicalUrl },
  ]),
  ...(post.faq.length > 0 ? [buildFaqJsonLd(post.faq)] : []),
];
---

<BaseLayout
  title={post.title}
  description={post.description}
  type="article"
  noindex={post.noindex}
  jsonLd={jsonLd}
  contained={false}
>
  <div id="progress"></div>

  <div class="read-shell">
    <aside class="toc-wrap">
      <details class="toc-details">
        <summary class="toc-summary">
          <span class="toc-title">Contents</span>
          <span class="toc-progress" aria-live="polite"><span id="toc-progress">0%</span></span>
          <svg
            class="toc-chevron"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </summary>
        <nav class="toc-nav" aria-label="Table of contents">
          <ol class="toc-list">
            {
              tableOfContents.map((entry) => (
                <li class={entry.isSub ? 'sub' : undefined}>
                  <a href={`#${entry.id}`} class="toc-link" data-target={entry.id}>
                    <span class="toc-num">{entry.label}</span>
                    <span>{entry.text}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </details>
    </aside>

    <div class="read-col">
      <a href="/blog/" class="back">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
        All guides
      </a>

      <header class="post-head">
        <span class="label">Guide &middot; {primaryTag}</span>
        <h1 class="post-title">{post.title}</h1>
        <p class="post-standfirst">{post.description}</p>
        <div class="post-byline">
          <span class="avatar">{authorInitials}</span>
          <span><strong>{SITE_AUTHOR}</strong></span>
          {post.pubDate && <span class="byline-dot" aria-hidden="true"></span>}
          {
            post.pubDate && (
              <time datetime={post.pubDate}>{formatDate(new Date(post.pubDate))}</time>
            )
          }
          <span class="byline-dot" aria-hidden="true"></span>
          <span>{readingMinutes} min read</span>
        </div>
      </header>

      {
        post.coverUrl && (
          <figure class="post-hero">
            <div class="post-hero-frame">
              <img
                src={post.coverUrl}
                alt={post.coverAlt ?? post.title}
                width="1280"
                height="720"
                loading="eager"
                decoding="async"
                fetchpriority="high"
                class="post-hero-image"
              />
            </div>
            {coverCredit && (coverCredit.creator || coverCredit.license) ? (
              <figcaption class="post-hero-credit">
                <span>Photo</span>
                {coverCredit.creator ? (
                  <span>
                    by{' '}
                    {coverCredit.creatorUrl ? (
                      <a href={coverCredit.creatorUrl} rel="noopener nofollow" target="_blank">
                        {coverCredit.creator}
                      </a>
                    ) : (
                      coverCredit.creator
                    )}
                  </span>
                ) : null}
                {coverCredit.license ? (
                  <span>
                    {coverCredit.creator ? <span aria-hidden="true">/ </span> : null}
                    {coverCredit.licenseUrl ? (
                      <a href={coverCredit.licenseUrl} rel="noopener nofollow" target="_blank">
                        {coverCredit.license.toUpperCase()}
                      </a>
                    ) : (
                      coverCredit.license.toUpperCase()
                    )}
                  </span>
                ) : null}
              </figcaption>
            ) : null}
          </figure>
        )
      }

      <AdSlot slotId="in-article-top" format="leaderboard" />

      {
        showsAffiliateDisclosure && <p class="post-disclosure">{disclosureText}</p>
      }

      <article class="post-body">
        <Fragment set:html={html} />
        {
          post.faq.length > 0 && (
            <section class="post-faq">
              <h2>Frequently asked questions</h2>
              <dl>
                {post.faq.map((entry) => (
                  <div>
                    <dt>{entry.question}</dt>
                    <dd>{entry.answer}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )
        }
      </article>

      <AdSlot slotId="in-article-bottom" format="leaderboard" />

      <footer class="post-foot">
        {
          post.tags.length > 0 && (
            <div class="tag-row">
              <span class="label">Filed under</span>
              {post.tags.map((tag) => (
                <a class="topic" href={`/tag/${tag}/`}>
                  {tag}
                </a>
              ))}
            </div>
          )
        }
      </footer>
    </div>

    <aside class="read-rail">
      <AdSlot slotId="article-rail-top" format="rectangle" />
      <div class="rail-card">
        <div class="rail-card-head">
          <span>Partner</span>
          <span>01</span>
        </div>
        <div class="rail-card-body">
          <h4>Sponsored placement</h4>
          <p>Reserved for a vetted product recommendation from a partner.</p>
          <a href="/affiliate-disclosure/" class="btn btn-primary btn-sm">How we vet partners</a>
        </div>
      </div>
      <AdSlot slotId="article-rail-bottom" format="rail" />
    </aside>
  </div>

  <script>
    const tocDetails = document.querySelector<HTMLDetailsElement>('.toc-details');
    if (tocDetails && window.matchMedia('(min-width: 1000px)').matches) {
      tocDetails.open = true;
    }

    const progressBar = document.getElementById('progress');
    const tocPercent = document.getElementById('toc-progress');
    const article = document.querySelector<HTMLElement>('.post-body');
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-link'));

    const sections = links
      .map((link) => {
        const target = link.dataset.target;
        return target ? document.getElementById(target) : null;
      })
      .filter((section): section is HTMLElement => section instanceof HTMLElement);

    if (sections.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((first, second) => second.intersectionRatio - first.intersectionRatio)[0];

          if (!visible) {
            return;
          }

          for (const link of links) {
            link.classList.toggle('active', link.dataset.target === visible.target.id);
          }
        },
        { rootMargin: '-140px 0px -55% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] },
      );

      for (const section of sections) {
        observer.observe(section);
      }
    }

    let animationFrame = 0;

    const updateProgress = (): void => {
      animationFrame = 0;
      const scrollableDistance = document.documentElement.scrollHeight - window.innerHeight;
      const ratio =
        scrollableDistance > 0 ? Math.min(Math.max(window.scrollY / scrollableDistance, 0), 1) : 0;

      if (progressBar) {
        progressBar.classList.add('on');
        progressBar.style.width = `${ratio * 100}%`;
      }

      if (tocPercent && article) {
        const rect = article.getBoundingClientRect();
        const articleTop = rect.top + window.scrollY;
        const readRatio = Math.min(
          Math.max((window.scrollY + window.innerHeight - articleTop) / rect.height, 0),
          1,
        );
        tocPercent.textContent = `${Math.round(readRatio * 100)}%`;
      }
    };

    window.addEventListener(
      'scroll',
      () => {
        if (animationFrame === 0) {
          animationFrame = requestAnimationFrame(updateProgress);
        }
      },
      { passive: true },
    );

    updateProgress();
  </script>
</BaseLayout>
