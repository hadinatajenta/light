---
import AdSlot from '@/components/AdSlot.astro';
import RelatedLinks from '@/components/RelatedLinks.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import {
  SITE_AUTHOR,
  SITE_AUTHOR_JOB_TITLE,
  SITE_AUTHOR_LINKEDIN,
  SITE_AUTHOR_SLUG,
  SITE_AUTHOR_WEBSITE,
  SITE_TITLE,
} from '@/consts';
import {
  extractHeadings,
  formatReadingTime,
  renderMarkdown,
  type SitePost,
} from '@/lib/content/public';
import { getRelatedPosts } from '@/lib/content/related';
import { INDEXABLE_TOPIC_SLUGS, topicLabel } from '@/lib/content/topics';
import { findMediaCreditByUrl } from '@/lib/media/store';
import { OG_CARD_HEIGHT, OG_CARD_WIDTH } from '@/lib/og/card';
import { formatDate } from '@/utils/date';
import {
  buildArticleJsonLd,
  buildBreadcrumbJsonLd,
  buildCanonicalUrl,
  buildFaqJsonLd,
} from '@/utils/seo';
import { buildTableOfContents } from '@/utils/toc';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: SitePost;
}

const { post } = Astro.props;

const { html } = renderMarkdown(post.body);
const tableOfContents = buildTableOfContents(extractHeadings(post.body));
const readingMinutes = formatReadingTime(post.body);
const kickerLabel = topicLabel(post.category ?? post.tags[0] ?? 'guide');
const authorInitials = SITE_AUTHOR.split(' ')
  .map((word) => word.charAt(0))
  .slice(0, 2)
  .join('')
  .toUpperCase();

const coverCredit = post.coverUrl ? await findMediaCreditByUrl(post.coverUrl) : null;
const bodyHasFaq = /^##[ \t]+frequently asked questions\??[ \t]*$/im.test(post.body);

const related = await getRelatedPosts(
  { id: post.id, tags: post.tags, category: post.category },
  6,
);
const categoryLabel = post.category ? topicLabel(post.category) : undefined;
const hubCategory =
  post.category && INDEXABLE_TOPIC_SLUGS.includes(post.category) ? post.category : undefined;
const hubPath = hubCategory ? `/tag/${hubCategory}/` : undefined;

const socialCard = post.noindex
  ? { image: post.coverUrl ?? undefined }
  : {
      image: `/og/${post.id}.png`,
      imageWidth: OG_CARD_WIDTH,
      imageHeight: OG_CARD_HEIGHT,
      imageAlt: post.title,
    };

const canonicalUrl =
  buildCanonicalUrl(Astro.site ?? undefined, Astro.url.pathname) ?? Astro.url.pathname;
const publishedDate = post.pubDate ? new Date(post.pubDate) : new Date();
const organizationLogoUrl = new URL('/og-default.png', Astro.site ?? Astro.url.origin).href;
const jsonLd = [
  buildArticleJsonLd({
    title: post.title,
    description: post.description,
    url: canonicalUrl,
    datePublished: publishedDate,
    dateModified: post.updatedDate ? new Date(post.updatedDate) : undefined,
    authorName: SITE_AUTHOR,
    authorUrl: new URL(`/author/${SITE_AUTHOR_SLUG}/`, Astro.site ?? Astro.url.origin).href,
    authorSameAs: [SITE_AUTHOR_LINKEDIN, SITE_AUTHOR_WEBSITE],
    authorJobTitle: SITE_AUTHOR_JOB_TITLE,
    publisherName: SITE_TITLE,
    publisherLogoUrl: organizationLogoUrl,
    image: post.coverUrl
      ? new URL(post.coverUrl, Astro.site ?? Astro.url.origin).href
      : undefined,
    articleSection: categoryLabel,
  }),
  buildBreadcrumbJsonLd([
    { name: 'Home', url: new URL('/', Astro.site ?? Astro.url.origin).href },
    hubPath && categoryLabel
      ? { name: categoryLabel, url: new URL(hubPath, Astro.site ?? Astro.url.origin).href }
      : { name: 'Guides', url: new URL('/blog/', Astro.site ?? Astro.url.origin).href },
    { name: post.title, url: canonicalUrl },
  ]),
  ...(post.faq.length > 0 ? [buildFaqJsonLd(post.faq)] : []),
];
---

<BaseLayout
  title={post.title}
  description={post.description}
  type="article"
  noindex={post.noindex}
  {...socialCard}
  jsonLd={jsonLd}
  contained={false}
>
  <div id="progress"></div>

  <div class="read-shell">
    <TableOfContents entries={tableOfContents} />

    <div class="read-col">
      <a href="/blog/" class="back">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
        All guides
      </a>

      <header class="post-head">
        <span class="label">Guide &middot; {kickerLabel}</span>
        <h1 class="post-title">{post.title}</h1>
        <p class="post-standfirst">{post.description}</p>
        <div class="post-byline">
          <span class="avatar">{authorInitials}</span>
          <a class="author-link" href={`/author/${SITE_AUTHOR_SLUG}/`} rel="author">
            <strong>{SITE_AUTHOR}</strong>
          </a>
          {post.pubDate && <span class="byline-dot" aria-hidden="true"></span>}
          {
            post.pubDate && (
              <time datetime={post.pubDate}>{formatDate(new Date(post.pubDate))}</time>
            )
          }
          <span class="byline-dot" aria-hidden="true"></span>
          <span>{readingMinutes} min read</span>
          {
            post.updatedDate && (
              <>
                <span class="byline-dot" aria-hidden="true" />
                <span>
                  Updated <time datetime={post.updatedDate}>{formatDate(new Date(post.updatedDate))}</time>
                </span>
              </>
            )
          }
          <span class="byline-dot" aria-hidden="true" />
          <a href="/editorial-standards/">How we research</a>
        </div>
      </header>

      {
        post.coverUrl && (
          <figure class="post-hero">
            <div class="post-hero-frame">
              <img
                src={post.coverUrl}
                alt={post.coverAlt ?? post.title}
                width="1280"
                height="720"
                loading="eager"
                decoding="async"
                fetchpriority="high"
                class="post-hero-image"
              />
            </div>
            {coverCredit && (coverCredit.creator || coverCredit.license) ? (
              <figcaption class="post-hero-credit">
                <span>Photo</span>
                {coverCredit.creator ? (
                  <span>
                    by{' '}
                    {coverCredit.creatorUrl ? (
                      <a href={coverCredit.creatorUrl} rel="noopener nofollow" target="_blank">
                        {coverCredit.creator}
                      </a>
                    ) : (
                      coverCredit.creator
                    )}
                  </span>
                ) : null}
                {coverCredit.license ? (
                  <span>
                    {coverCredit.creator ? <span aria-hidden="true">/ </span> : null}
                    {coverCredit.licenseUrl ? (
                      <a href={coverCredit.licenseUrl} rel="noopener nofollow" target="_blank">
                        {coverCredit.license.toUpperCase()}
                      </a>
                    ) : (
                      coverCredit.license.toUpperCase()
                    )}
                  </span>
                ) : null}
              </figcaption>
            ) : null}
          </figure>
        )
      }

      <AdSlot slotId="in-article-top" format="leaderboard" />

      <article class="post-body">
        <Fragment set:html={html} />
        {
          post.faq.length > 0 && !bodyHasFaq && (
            <section class="post-faq">
              <h2>Frequently asked questions</h2>
              <dl>
                {post.faq.map((entry) => (
                  <div>
                    <dt>{entry.question}</dt>
                    <dd>{entry.answer}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )
        }
      </article>

      <RelatedLinks posts={related} topicHref={hubPath} topicLabel={hubPath ? categoryLabel : undefined} />

      <AdSlot slotId="in-article-bottom" format="leaderboard" />

      <footer class="post-foot">
        {
          post.tags.length > 0 && (
            <div class="tag-row">
              <span class="label">Filed under</span>
              {post.tags.map((tag) => (
                <a class="topic" href={`/tag/${tag}/`}>
                  {topicLabel(tag)}
                </a>
              ))}
            </div>
          )
        }
      </footer>
    </div>

    <aside class="read-rail">
      <AdSlot slotId="article-rail-top" format="rectangle" />
      <AdSlot slotId="article-rail-bottom" format="rail" />
    </aside>
  </div>
</BaseLayout>
