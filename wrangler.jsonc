{
  "name": "light",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://nameless-tree-67b1.cloudflareaccess.com",
    "ACCESS_AUD": "780ac9b13f44fd3ed1944d790f90882cbe714115f6f72c4ff74c9adc01498528",
    "GITHUB_REPO": "hadinatajenta/light",
    "GITHUB_BRANCH": "main"
  },
  "d1_databases": [
    {
      "binding": "CONTENT_DB",
      "database_name": "light-content",
      "database_id": "9e14ae8a-5736-4458-b199-2deeb40abe8c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "light-media"
    }
  ],
  "routes": [
    { "pattern": "light.hadinata.me", "custom_domain": true },
    { "pattern": "admin.hadinata.me", "custom_domain": true },
    { "pattern": "lightscripts.com", "custom_domain": true },
    { "pattern": "www.lightscripts.com", "custom_domain": true },
    { "pattern": "admin.lightscripts.com", "custom_domain": true }
  ]
}
